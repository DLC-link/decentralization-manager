LOCALNET_VERSION=0.6.12
DECMAN_IMAGE=public.ecr.aws/dlc-link/decentralization-manager:v1.8.0

# v1.8.0 is linux/amd64 only, so the containers are pinned to it: without the
# pin Docker on arm64 fails with "no matching manifest", and on arm64 Linux
# without binfmt it fails with "exec format error". Releases after this one
# carry both architectures — drop this line, and the Apple Silicon note in
# README.md, once DECMAN_IMAGE points at such a tag.
DECMAN_PLATFORM=linux/amd64
