-- | Granular onboarding action: the registrar decparty revokes the
-- credentials it self-issued for instrument issuers, removing their
-- issuing privileges. Externally-issued credentials are out of scope: the
-- checked fetch on issuer == holder == governanceParty rejects them.
--
-- The offboarded parties are not restated in the payload: each credential's
-- claims name the issuer it attests for, and the claims are the single
-- source of truth.
--
-- The action revokes only the credentials the caller lists. On-chain checks
-- cannot enumerate a party's credentials, so completeness is the caller's
-- responsibility: an issuer keeps minting rights through any live credential
-- the proposal omits. Proposal tooling must list every credential the
-- governance party self-issued for the offboarded issuers.
module Governance.UtilityOnboarding.OffboardInstrumentIssuers where

import DA.List (dedup, unique)

import Splice.Util (fetchChecked)
import Utility.Credential.V0.Credential
  (Credential, Credential_Revoke(..), WithIssuerHolder(..))

import Governance.Action

template OffboardInstrumentIssuers
  with
    governanceParty : Party
      -- ^ The registrar decparty that issued the credentials.
    proposer : Party
    instrumentIssuerCids : [ContractId Credential]
      -- ^ Credentials the governance party self-issued for the offboarded
      -- instrument issuers.
  where
    signatory proposer
    observer governanceParty
    -- An offboard action that revokes no credentials does no work; reject
    -- it at creation rather than record a no-op governance result. A
    -- duplicated cid would revoke the same credential twice — the second
    -- revoke hits an archived contract and fails the whole action at
    -- execution — so reject duplicates too.
    ensure not (null instrumentIssuerCids)
        && unique instrumentIssuerCids

    interface instance GovernableAction for OffboardInstrumentIssuers where
      view = GovernableActionView with
        governanceParty
        proposer
        actionLabel = "OffboardInstrumentIssuers"
        description = "Offboard instrument issuers (revoke "
          <> show (length instrumentIssuerCids) <> " credentials)"

      executeImpl = do
        _ <- forA instrumentIssuerCids $ \credentialCid -> do
          credential <- fetchChecked
            (WithIssuerHolder with
               issuer = governanceParty
               holder = governanceParty)
            credentialCid
          -- A claimless credential attests for nobody; refuse to treat it
          -- as belonging to any particular issuer.
          assertMsg "OffboardInstrumentIssuers: credential has no claims"
            (not $ null credential.claims)
          -- Claims naming several subjects would revoke more than one
          -- issuer's attestation in one opaque step; refuse them.
          assertMsg "OffboardInstrumentIssuers: credential claims name more than one subject"
            (length (dedup (map (.subject) credential.claims)) == 1)
          exercise credentialCid Credential_Revoke with actor = governanceParty
        pure ()
