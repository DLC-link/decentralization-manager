-- | Composite onboarding action: SetupUtility
module Governance.UtilityOnboarding.SetupUtility where

import Utility.Registry.App.V0.Service.Provider
  (ProviderService,
   ProviderService_CreateProviderConfiguration(..),
   ProviderService_AcceptRegistrarServiceRequest(..))
import Utility.Registry.App.V0.Service.Registrar
  (RegistrarService_CreateInstrumentConfiguration(..),
   RegistrarServiceRequest(..),
   RegistrarServiceRequest_Accept(..))
import Utility.Registry.Holding.V0.Types (InstrumentIdentifier)

import Governance.Action
import Governance.UtilityOnboarding.Utils (blockListSupported, blockListText)

-- | Composite onboarding action: runs the full onboarding chain in one vote.
-- Flags drive optional steps on the RegistrarServiceRequest.
template SetupUtility
  with
    governanceParty : Party
    proposer : Party
    providerServiceCid : ContractId ProviderService
    operator : Party
    instrumentIdText : Text
    additionalIdentifiers : [InstrumentIdentifier]
    createTransferRule : Bool
    createAllocationFactory : Bool
    useBlockList : Optional Bool
      -- ^ checkBlockList of the created configuration. Some True is refused
      -- until every mint, burn and transfer path sends block list shards
      -- (#566).
      -- Optional and last so contracts created without it upgrade with
      -- None, which leaves the check off.
  where
    signatory proposer
    observer governanceParty
    ensure blockListSupported useBlockList

    interface instance GovernableAction for SetupUtility where
      view = GovernableActionView with
        governanceParty
        proposer
        actionLabel = "SetupUtility"
        description = "Composite onboarding: register instrument " <> instrumentIdText
          <> blockListText useBlockList

      executeImpl = do
        providerConfigurationCid <- (.providerConfigurationCid) <$>
          exercise providerServiceCid ProviderService_CreateProviderConfiguration with
            registrarRequirements = []
            holderRequirements = []
        registrarServiceRequestCid <- create RegistrarServiceRequest with
          operator
          provider = governanceParty
          registrar = governanceParty
          createTransferRule = if createTransferRule then Some True else None
          createAllocationFactory = if createAllocationFactory then Some True else None
        result <- exercise providerServiceCid ProviderService_AcceptRegistrarServiceRequest with
          cid = registrarServiceRequestCid
          payload = RegistrarServiceRequest_Accept with
            providerConfigurationCid
            credentialCids = []
        _ <- exercise result.registrarServiceCid RegistrarService_CreateInstrumentConfiguration with
          instrumentId = instrumentIdText
          additionalIdentifiers = additionalIdentifiers
          issuerRequirements = []
          holderRequirements = []
          useBlockList
        pure ()
