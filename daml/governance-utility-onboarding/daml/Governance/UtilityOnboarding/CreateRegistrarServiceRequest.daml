-- | The registrar decparty asks a provider for registrar service.
--
-- The registrar is the request's only signatory. Governance authority alone
-- therefore creates it. The provider accepts the request later, through
-- OnboardRegistrar on the provider's own decparty.
module Governance.UtilityOnboarding.CreateRegistrarServiceRequest where

import Utility.Registry.App.V0.Service.Registrar (RegistrarServiceRequest(..))

import Governance.Action

template CreateRegistrarServiceRequest
  with
    governanceParty : Party
      -- ^ The registrar decparty. Becomes the request's registrar.
    proposer : Party
    operator : Party
    provider : Party
    createTransferRule : Bool
    createAllocationFactory : Bool
  where
    signatory proposer
    observer governanceParty

    interface instance GovernableAction for CreateRegistrarServiceRequest where
      view = GovernableActionView with
        governanceParty
        proposer
        actionLabel = "CreateRegistrarServiceRequest"
        description = "Request registrar service (operator " <> show operator
          <> ", provider " <> show provider <> ")"

      executeImpl = do
        _ <- create RegistrarServiceRequest with
          operator
          provider
          registrar = governanceParty
          createTransferRule = if createTransferRule then Some True else None
          createAllocationFactory = if createAllocationFactory then Some True else None
        pure ()
