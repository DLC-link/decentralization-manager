-- | Shared helpers for the utility onboarding governance actions.
module Governance.UtilityOnboarding.Utils where

import DA.Date (Month(Jan), date)
import DA.Foldable (forA_)
import DA.Set qualified as Set
import DA.Text (intercalate, isInfixOf)
import DA.Time (convertRelTimeToMicroseconds, subTime, time)

import Splice.Api.Token.MetadataV1 (AnyValue(..))
import Splice.Util (require)
import Utility.Credential.V0.Credential
  (Claim(..), Credential(..), PartyCredentialRequirement(..))
import Utility.Registry.V0.Holding.TokenApiUtils (blockListContextKey)
import Utility.Registry.V0.Rule.BlockList (StoredBlockListPartyShas)

-- | Render a party list for a proposal description: full ids via `show`,
-- joined by ", ". The executed description is copied into the on-chain
-- GovernanceExecutionResult.
partyList : [Party] -> Text
partyList = intercalate ", " . map show

-- | True when every requirement the governance party would self-issue
-- carries at least one required claim. Proposal templates use this in
-- their `ensure` clause: a claimless self-issued requirement can never be
-- minted (the assert in `mintCredentialsMeetingRequirements` refuses it),
-- so a configuration carrying one would pass its own vote and then fail
-- every later onboard action that mints against it. Requirements from
-- other issuers are out of scope — those credentials arrive out of band.
selfIssuedRequirementsHaveClaims : Party -> [PartyCredentialRequirement] -> Bool
selfIssuedRequirementsHaveClaims governanceParty =
  all (\requirement ->
    requirement.issuer /= governanceParty
      || not (null requirement.requiredClaims))

-- | True when a credential id nonce is absent, or present, non-empty and
-- free of "/". Readers split credential ids on "/", so a nonce holding one
-- would shift the segments after it. Proposal templates that mint use this
-- in their `ensure` clause, so a bad nonce fails before any vote.
validCredentialIdNonce : Optional Text -> Bool
validCredentialIdNonce =
  optional True (\nonce -> nonce /= "" && not ("/" `isInfixOf` nonce))

-- | True when a credential validity window is open-ended on either side,
-- or starts strictly before it ends. Proposal templates that mint use this
-- in their `ensure` clause, so an empty window fails before any vote.
validCredentialValidity : Optional Time -> Optional Time -> Bool
validCredentialValidity (Some validFrom) (Some validUntil) = validFrom < validUntil
validCredentialValidity _ _ = True

-- | Describe a credential validity window for a proposal description, with a
-- leading separator, or nothing when the window is unbounded. Voters see
-- only the description, and an expiry is part of what they approve.
credentialValidityText : Optional Time -> Optional Time -> Text
credentialValidityText None None = ""
credentialValidityText validFrom validUntil =
  "; credentials valid"
    <> optional "" (\t -> " from " <> show t) validFrom
    <> optional "" (\t -> " until " <> show t) validUntil

-- | True unless the block list flag is Some True. With the flag on, the
-- registry refuses every mint, burn and transfer whose choice context lacks
-- the registrar's block list shards. AcceptMintRequest and AcceptBurnRequest
-- carry them. MintProposal and BurnProposal do not, and nobody has checked
-- what wallet and cbtc-lib transfers send (#566). Proposal templates use
-- this in their `ensure` clause, so the flag fails before any vote.
blockListSupported : Optional Bool -> Bool
blockListSupported = (/= Some True)

-- | The choice context entry for block list shards, or none when unset. The
-- registry reads the shards back with `getFromContextU`, which takes a list
-- of contract ids.
blockListContextEntries
  : Optional [ContractId StoredBlockListPartyShas] -> [(Text, AnyValue)]
blockListContextEntries = optional [] \cids ->
  [(blockListContextKey, AV_List $ map (AV_ContractId . coerceContractId) cids)]

-- | Describe an instrument configuration's block list flag for a proposal
-- description, with a leading separator, or nothing when it is unset. The
-- registry checks the block list only on Some True.
blockListText : Optional Bool -> Text
blockListText None = ""
blockListText (Some True) = "; block list on"
blockListText (Some False) = "; block list off"

-- | Render a governance-minted credential id:
--
-- * with a nonce: {roleTag}/{subject}/{timestamp}-{nonce}-{index}
-- * without one: {roleTag}/{subject}/{timestamp}-{index}
--
-- The timestamp is the minting transaction's ledger time in seconds since
-- epoch. The index separates credentials minted for the same subject within
-- one transaction. The nonce comes from the proposal and separates actions
-- that mint for the same subject and role tag at the same timestamp. Daml
-- exposes no transaction id, and a finer timestamp would not help: Canton
-- raises a transaction's ledger time to that of its inputs, so two
-- transactions can share one ledger time.
mkCredentialId : Text -> Party -> Time -> Optional Text -> Int -> Text
mkCredentialId roleTag subject now nonce index =
  roleTag <> "/" <> partyToText subject <> "/"
    <> show (convertRelTimeToMicroseconds (subTime now epoch) / 1000000)
    <> optional "" ("-" <>) nonce
    <> "-" <> show index
  where
    epoch = time (date 1970 Jan 1) 0 0 0

-- | Mint the credentials that make `subject` meet every requirement the
-- governance party can self-issue. Requirements from other issuers are
-- skipped; those issuers mint out of band and the credentials arrive as
-- extra inputs on the consuming action.
--
-- Minted credentials have `issuer == holder == governanceParty`. The SDK's
-- `assertFulfillsAllRequirements` accepts issuer-held credentials
-- (`holder == issuer`) for any subject whose claims match, so no two-step
-- offer/accept flow is needed. The subject is an observer because it later
-- exercises `Credential_Get` and references the cids in mint/burn requests.
--
-- A self-issuable requirement with no required claims is refused: the
-- resulting claimless credential would attest for nobody.
--
-- The validity window comes from the proposal and is copied onto every
-- minted credential. `None` on both sides mints credentials that never
-- expire. A window that has already ended when the action executes is
-- refused, because it would mint credentials that are expired on creation.
mintCredentialsMeetingRequirements
  : Party
    -- ^ Governance party. Issuer and holder of every minted credential.
  -> Party
    -- ^ Subject the credentials attest for.
  -> Text
    -- ^ Role tag used in the credential id, e.g. "registrar-credential"
    -- or "{symbol}-instrument-issuer-credential".
  -> Optional Text
    -- ^ The proposal's credential id nonce. See `mkCredentialId`.
  -> Optional Time
    -- ^ The proposal's credential validFrom. None: valid from creation.
  -> Optional Time
    -- ^ The proposal's credential validUntil. None: never expires.
  -> [PartyCredentialRequirement]
    -- ^ Full requirement list. Filtered internally.
  -> Update [ContractId Credential]
mintCredentialsMeetingRequirements governanceParty subject roleTag nonce validFrom validUntil requirements = do
  now <- getTime
  forA_ validUntil \until ->
    require
      ("mintCredentialsMeetingRequirements: credential validity ended at " <> show until
        <> ", before execution at " <> show now)
      (now < until)
  let selfIssuable = filter (\requirement -> requirement.issuer == governanceParty) requirements
      mkClaim (property, value) = Claim with
        subject = partyToText subject
        property
        value
  forA (zip [0 .. length selfIssuable - 1] selfIssuable) $ \(index, requirement) -> do
    require
      ("mintCredentialsMeetingRequirements: requirement issued by the governance party has no required claims; a claimless credential attests for nobody: "
        <> show requirement)
      (not $ null requirement.requiredClaims)
    create Credential with
      issuer = governanceParty
      holder = governanceParty
      id = mkCredentialId roleTag subject now nonce index
      description = "Governance-minted " <> roleTag <> " for " <> partyToText subject
      validFrom
      validUntil
      claims = map mkClaim requirement.requiredClaims
      observers = Set.fromList [subject]
