-- | Granular onboarding action: the registrar decparty creates an
-- InstrumentConfiguration and credentials the initial instrument issuers.
-- Executed once per instrument.
module Governance.UtilityOnboarding.ProvisionInstrument where

import Utility.Credential.V0.Credential (PartyCredentialRequirement)
import Utility.Registry.App.V0.Service.Registrar
  (RegistrarService, RegistrarService_CreateInstrumentConfiguration(..))
import Utility.Registry.Holding.V0.Types (InstrumentIdentifier)

import Governance.Action
import Governance.UtilityOnboarding.Utils (mintCredentialsMeetingRequirements)

template ProvisionInstrument
  with
    governanceParty : Party
      -- ^ The registrar decparty. Must equal the RegistrarService's registrar.
    proposer : Party
    registrarServiceCid : ContractId RegistrarService
    instrumentIdText : Text
    additionalIdentifiers : [InstrumentIdentifier]
    issuerRequirements : [PartyCredentialRequirement]
    holderRequirements : [PartyCredentialRequirement]
    initialInstrumentIssuers : [Party]
  where
    signatory proposer
    observer governanceParty

    interface instance GovernableAction for ProvisionInstrument where
      view = GovernableActionView with
        governanceParty
        proposer
        actionLabel = "ProvisionInstrument"
        description = "Provision instrument " <> instrumentIdText
          <> " (" <> show (length initialInstrumentIssuers) <> " initial issuers)"

      executeImpl = do
        -- The choice controller is the registrar, so a RegistrarService whose
        -- registrar is not the governance party fails on authorization.
        _ <- exercise registrarServiceCid RegistrarService_CreateInstrumentConfiguration with
          instrumentId = instrumentIdText
          additionalIdentifiers
          issuerRequirements
          holderRequirements
        _ <- forA initialInstrumentIssuers $ \instrumentIssuer ->
          mintCredentialsMeetingRequirements
            governanceParty instrumentIssuer "instrument-issuer-credential"
            issuerRequirements
        pure ()
