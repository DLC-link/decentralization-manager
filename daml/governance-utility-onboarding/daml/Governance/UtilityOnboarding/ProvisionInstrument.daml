-- | Granular onboarding action: the registrar decparty creates an
-- InstrumentConfiguration and credentials the initial instrument issuers.
-- Executed once per instrument.
module Governance.UtilityOnboarding.ProvisionInstrument where

import DA.List (unique)

import Utility.Credential.V0.Credential (PartyCredentialRequirement)
import Utility.Registry.App.V0.Service.Registrar
  (RegistrarService, RegistrarService_CreateInstrumentConfiguration(..))
import Utility.Registry.Holding.V0.Types (InstrumentIdentifier)

import Governance.Action
import Governance.UtilityOnboarding.Utils
  (mintCredentialsMeetingRequirements, partyList, selfIssuedRequirementsHaveClaims)

template ProvisionInstrument
  with
    governanceParty : Party
      -- ^ The registrar decparty. Must equal the RegistrarService's registrar.
    proposer : Party
    registrarServiceCid : ContractId RegistrarService
    instrumentIdText : Text
    additionalIdentifiers : [InstrumentIdentifier]
    issuerRequirements : [PartyCredentialRequirement]
    holderRequirements : [PartyCredentialRequirement]
    initialInstrumentIssuers : [Party]
  where
    signatory proposer
    observer governanceParty
    -- A claimless issuer requirement the registrar would self-issue can
    -- never be minted. With no initial issuers the mint assert never runs,
    -- so the configuration would be created carrying the bad requirement
    -- and every later OnboardInstrumentIssuers against it would fail.
    -- Refuse it before any vote. Holder requirements are not minted
    -- against, so they stay unchecked. A duplicated initial issuer would
    -- mint two credentials sharing one id (ids derive from subject, mint
    -- time and a per-call index), leaving rows the offboard picker cannot
    -- tell apart — reject duplicates too.
    ensure selfIssuedRequirementsHaveClaims governanceParty issuerRequirements
        && unique initialInstrumentIssuers

    interface instance GovernableAction for ProvisionInstrument where
      view = GovernableActionView with
        governanceParty
        proposer
        actionLabel = "ProvisionInstrument"
        -- Voters see only this text; name every party gaining minting rights.
        description = "Provision instrument " <> instrumentIdText
          <> case initialInstrumentIssuers of
               [] -> ", no initial issuers"
               issuers -> ", initial issuers " <> partyList issuers

      executeImpl = do
        -- Controller authorization alone is not enough: the proposer's
        -- authority is in scope during execution, so a service owned by the
        -- proposer would pass it. Pin the service to the governance party.
        registrarService <- fetch registrarServiceCid
        assertMsg "ProvisionInstrument: registrar service registrar does not match the governance party"
          (registrarService.registrar == governanceParty)
        result <- exercise registrarServiceCid RegistrarService_CreateInstrumentConfiguration with
          instrumentId = instrumentIdText
          additionalIdentifiers
          issuerRequirements
          holderRequirements
        -- Mint from the stored configuration, not the proposal parameter.
        -- OnboardInstrumentIssuers credentials later issuers from what the
        -- configuration stores, so if the SDK choice ever rewrites the
        -- requirements it records, minting from the proposal's copy would
        -- give initial issuers different credentials than later ones.
        instrumentConfiguration <- fetch result.instrumentConfigurationCid
        _ <- forA initialInstrumentIssuers $ \instrumentIssuer ->
          mintCredentialsMeetingRequirements
            governanceParty instrumentIssuer "instrument-issuer-credential"
            instrumentConfiguration.issuerRequirements
        pure ()
