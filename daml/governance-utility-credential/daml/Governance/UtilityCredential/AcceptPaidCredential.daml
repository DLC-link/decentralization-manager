-- | Governable action wrapping `UserService_AcceptPaidCredentialOffer` from
-- the Utility Credential App: accepts a paid credential offer. The governance
-- party is the holder of the credential being accepted, and locks its own
-- Amulets as the deposit that pays the credential fees.
--
-- UTXO Timing Risk:
-- The depositAmulets and the appTransferContext are captured at proposal
-- creation time. If any deposit Amulet is consumed (spent, merged, split)
-- between proposal creation and governance execution, the accept fails.
-- The open mining round in appTransferContext closes after two ticks (about
-- 20 minutes on the global synchronizer), and the accept fails once it does.
-- Mitigations:
--   1. Use dedicated Amulets reserved for governance proposals
--   2. Confirm and execute within the open round's lifetime
--   3. Monitor and re-propose if the Amulets or the round change
module Governance.UtilityCredential.AcceptPaidCredential where

import CredentialApp.Splice.Amulet (Amulet)
import CredentialApp.Splice.AmuletRules (AppTransferContext)
import Utility.Credential.App.V0.Model.Offer (CredentialOffer)
import Utility.Credential.App.V0.Service.User
  (UserService, UserService_AcceptPaidCredentialOffer(..))

import Governance.Action
import Governance.UtilityCredential.Service (requireGovernanceUserService)

-- | Proposal to accept a paid credential offer. Authority flows
-- GovernanceRules → GovernableAction_Execute → executeImpl
-- → UserService_AcceptPaidCredentialOffer (controller: user = governanceParty).
template AcceptPaidCredential
  with
    governanceParty : Party
      -- ^ The governance party whose authority is required.
      -- Must equal the `user` field of the referenced UserService.
    proposer : Party
      -- ^ The member proposing this acceptance.
    userServiceCid : ContractId UserService
      -- ^ The governance party's UserService.
    credentialOfferCid : ContractId CredentialOffer
      -- ^ The paid credential offer to accept.
    depositAmulets : [ContractId Amulet]
      -- ^ The governance party's unlocked Amulets that fund the deposit.
    appTransferContext : AppTransferContext
      -- ^ The AmuletRules, open mining round and optional featured app right
      -- used to lock the deposit.
  where
    signatory proposer
    observer governanceParty

    ensure not (null depositAmulets)

    interface instance GovernableAction for AcceptPaidCredential where
      view = GovernableActionView with
        governanceParty
        proposer
        actionLabel = "AcceptPaidCredential"
        description = "Accept paid credential offer (offer " <> show credentialOfferCid
          <> ", " <> show (length depositAmulets) <> " deposit Amulets)"

      executeImpl = do
        requireGovernanceUserService "AcceptPaidCredential" governanceParty userServiceCid
        _ <- exercise userServiceCid UserService_AcceptPaidCredentialOffer with
          credentialOfferCid
          depositAmulets
          appTransferContext
        pure ()
