-- | Standing delegation that carries the decparty's authority and the fixed
-- beneficiary split. Created ONCE via governance (SetupCouponReassignmentDelegation);
-- thereafter any single listed assigner may reassign a coupon batch to the baked-in
-- split with a plain Delegation_Assign exercise — no per-round vote.
module Governance.Rewards.CouponReassignmentDelegation where

import Splice.Amulet (RewardCouponV2)
import Splice.Api.RewardAssignmentV1
  (RewardCoupon, RewardBeneficiary, RewardCoupon_AssignBeneficiaries(..))
import Splice.Api.Token.MetadataV1 (ExtraArgs)

template CouponReassignmentDelegation
  with
    decparty  : Party                 -- = governanceParty = the coupons' provider
    dso       : Party                 -- the DSO whose coupons may be assigned
    assigners : [Party]               -- any one may reassign (1-of-n)
    split     : [RewardBeneficiary]   -- BAKED IN; validated at create
  where
    signatory decparty
    observer assigners

    nonconsuming choice Delegation_Assign : ()
      with
        assigner          : Party
        primaryCoupon     : ContractId RewardCoupon
        additionalCoupons : [ContractId RewardCoupon]
        extraArgs         : ExtraArgs
          -- ^ passed through to RewardCoupon_AssignBeneficiaries; empty today,
          -- but a later RewardCoupon version may require a populated context.
      controller assigner
      do
        assertMsg "assigner must be listed on the delegation" (assigner `elem` assigners)
        -- Fetch as the concrete RewardCouponV2, then check the dso. Both guards
        -- are load-bearing: without the typed fetch, a look-alike implementation
        -- whose view claims `provider = decparty` satisfies
        -- RewardCoupon_AssignBeneficiaries' `controller (view this).provider`
        -- and runs its own code with this delegation's authority; without the
        -- dso check, any party can mint a genuine RewardCouponV2 naming itself
        -- dso, and as a batch's primary it makes splice reject every real
        -- coupon alongside it.
        coupon <- fetch (fromInterfaceContractId @RewardCouponV2 primaryCoupon)
        assertMsg "coupon dso must match the delegation's dso" (coupon.dso == dso)
        _ <- exercise primaryCoupon RewardCoupon_AssignBeneficiaries with
               additionalCoupons
               newBeneficiaries = split   -- the contract's split, never a caller argument
               extraArgs
        pure ()

    -- Governance-only revoke. Invoked via a GovernableAction.
    choice Delegation_Revoke : ()
      controller decparty
      do pure ()
