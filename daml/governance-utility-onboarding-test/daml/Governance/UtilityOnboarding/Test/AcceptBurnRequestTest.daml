module Governance.UtilityOnboarding.Test.AcceptBurnRequestTest where

import DA.Optional (isSome)
import DA.TextMap qualified as TextMap
import DA.Time (addRelTime, hours)
import Daml.Script

import Splice.Api.Token.HoldingV1 (InstrumentId(..))
import Splice.Api.Token.MetadataV1
  (AnyValue(..), ChoiceContext(..), ExtraArgs(..), Metadata(..))

import Utility.Registry.App.V0.Model.Burn (Burn(..), BurnRequest)
import Utility.Registry.App.V0.Model.Mint (Mint(..))
import Utility.Registry.App.V0.Service.AllocationFactory
  (AllocationFactory_RequestBurn(..), AllocationFactory_RequestMint(..))
import Utility.Registry.Holding.V0.Holding (Holding)
import Utility.Registry.V0.Holding.TokenApiUtils
  (blockListContextKey, instrumentConfigurationContextKey, issuerCredentialsContextKey)
import Utility.Registry.V0.Rule.BlockList (StoredBlockListPartyShas)

import Governance.Action (GovernableAction)
import Governance.Rules

import Governance.TokenIssuance.AcceptBurnRequest
import Governance.TokenIssuance.AcceptMintRequest
import Governance.UtilityOnboarding.TestUtils

import TestHarness

data Fixture = Fixture
  with
    parties : OnboardingTestParties
    rulesCid : ContractId GovernanceRules
    artifacts : SetupArtifacts
    burnRequestCid : ContractId BurnRequest
    burnAmount : Decimal
    holder : Party
  deriving (Eq, Show)

mkInstrumentId : OnboardingTestParties -> InstrumentId
mkInstrumentId parties = InstrumentId with
  admin = parties.governanceParty
  id = "TEST-TOKEN"

-- | The factory checks the block list too, so a request on a configuration
-- that checks it needs the shards.
choiceContextWithEmptyCredentials
  : SetupArtifacts -> Optional [ContractId StoredBlockListPartyShas] -> ChoiceContext
choiceContextWithEmptyCredentials artifacts shardCids = ChoiceContext with
  values = TextMap.fromList $
    [ (instrumentConfigurationContextKey,
       AV_ContractId $ coerceContractId artifacts.instrumentConfigurationCid)
    , (issuerCredentialsContextKey, AV_List [])
    ] <> blockListShardEntries shardCids

-- | Seed the requester with a Holding by driving a holder-initiated mint
-- request through governance — exercises the AcceptMintRequest action under
-- test only as a setup helper.
seedHoldingForRequester
  : OnboardingTestParties -> ContractId GovernanceRules -> SetupArtifacts
  -> Optional [ContractId StoredBlockListPartyShas] -> Party -> Decimal
  -> Script (ContractId Holding)
seedHoldingForRequester parties rulesCid artifacts shardCids holder amount = do
  now <- getTime
  let context = choiceContextWithEmptyCredentials artifacts shardCids
  mintResult <- submit (actAs holder <> readAs parties.governanceParty) $
    exerciseCmd artifacts.allocationFactoryCid AllocationFactory_RequestMint with
      expectedAdmin = parties.governanceParty
      mint = Mint with
        instrumentId = mkInstrumentId parties
        amount
        holder
        reference = "Seed holding via mint request"
        requestedAt = now
        executeBefore = now `addRelTime` hours 24
        meta = Metadata with values = TextMap.empty
      extraArgs = ExtraArgs with
        context
        meta = Metadata with values = TextMap.empty
  proposalCid <- submit parties.member1 $ createCmd AcceptMintRequest with
    governanceParty = parties.governanceParty
    proposer = parties.member1
    mintRequestCid = mintResult.mintRequestCid
    instrumentConfigurationCid = artifacts.instrumentConfigurationCid
    issuerCredentialCids = None
    description = "Seed mint"
    extraArgsMeta = Metadata with values = TextMap.empty
    blockListShardCids = shardCids
  let proposalInterfaceCid : ContractId GovernableAction = toInterfaceContractId proposalCid
  _ <- confirmAndExecute parties rulesCid proposalInterfaceCid
    [parties.member1, parties.member2] parties.member1
  -- Read the freshly minted holding owned by the requester.
  [(holdingCid, _)] <- query @Holding holder
  pure holdingCid

-- | Drive a holder-initiated burn request through the registry factory.
seedBurnRequest
  : OnboardingTestParties -> SetupArtifacts
  -> Optional [ContractId StoredBlockListPartyShas] -> Party -> Decimal
  -> ContractId Holding -> Script (ContractId BurnRequest)
seedBurnRequest parties artifacts shardCids holder amount holdingCid = do
  now <- getTime
  let context = choiceContextWithEmptyCredentials artifacts shardCids
  result <- submit (actAs holder <> readAs parties.governanceParty) $
    exerciseCmd artifacts.allocationFactoryCid AllocationFactory_RequestBurn with
      expectedAdmin = parties.governanceParty
      burn = Burn with
        instrumentId = mkInstrumentId parties
        amount
        holder
        reference = "Holder-initiated burn"
        requestedAt = now
        executeBefore = now `addRelTime` hours 24
        meta = Metadata with values = TextMap.empty
      holdingCids = [holdingCid]
      extraArgs = ExtraArgs with
        context
        meta = Metadata with values = TextMap.empty
  pure result.burnRequestCid

given_burn_request_exists : Script Fixture
given_burn_request_exists = do
  parties <- allocateOnboardingTestParties
  rulesCid <- createTestGovernance parties
  artifacts <- setupUtilityForTest parties rulesCid
  let holder = parties.outsider
      burnAmount = 100.0
  holdingCid <- seedHoldingForRequester parties rulesCid artifacts None holder burnAmount
  burnRequestCid <- seedBurnRequest parties artifacts None holder burnAmount holdingCid
  pure Fixture with ..

proposeAcceptBurn
  : Optional [ContractId StoredBlockListPartyShas] -> Fixture
  -> Script (ContractId GovernableAction)
proposeAcceptBurn shardCids f = do
  proposalCid <- submit f.parties.member1 $ createCmd AcceptBurnRequest with
    governanceParty = f.parties.governanceParty
    proposer = f.parties.member1
    burnRequestCid = f.burnRequestCid
    instrumentConfigurationCid = f.artifacts.instrumentConfigurationCid
    issuerCredentialCids = None
    description = "Accept holder-initiated burn"
    extraArgsMeta = Metadata with values = TextMap.empty
    blockListShardCids = shardCids
  pure (toInterfaceContractId proposalCid)

executeAcceptBurn : Optional [ContractId StoredBlockListPartyShas] -> Fixture -> Script ()
executeAcceptBurn shardCids f = do
  proposalCid <- proposeAcceptBurn shardCids f
  _ <- confirmAndExecute f.parties f.rulesCid proposalCid
    [f.parties.member1, f.parties.member2] f.parties.member1
  pure ()

-- | Confirm the accept, run it, and return the failure.
executeAcceptBurnMustFail
  : Optional [ContractId StoredBlockListPartyShas] -> Fixture -> Script Text
executeAcceptBurnMustFail shardCids f = do
  proposalCid <- proposeAcceptBurn shardCids f
  confirmationCids <- submitConfirmations f.parties.governanceParty f.rulesCid proposalCid
    [f.parties.member1, f.parties.member2]
  failure <- submitWithError (actAs f.parties.member1
    <> readAs f.parties.governanceParty
    <> readAs f.parties.outsider
    <> readAs f.parties.operator) $
    exerciseCmd f.rulesCid GovernanceRules_ExecuteConfirmedAction with
      executor = f.parties.member1
      actionProposalCid = proposalCid
      confirmations = confirmationCids
  pure (show failure)

-- * Happy path: propose-confirm-execute burns the holder's holding.

when_accept_burn_request_executed : Fixture -> Script ()
when_accept_burn_request_executed = executeAcceptBurn None

-- Registry-app 0.9.0 and later create no ExecutedBurn receipt, so the
-- consumed request stands in for it.
then_holding_burned : Fixture -> () -> Script Failures
then_holding_burned f _ = do
  holdings <- query @Holding f.holder
  requests <- query @BurnRequest f.parties.governanceParty
  pure $
    shouldBe "remaining holdings for holder" 0 (length holdings) <>
    shouldBe "open BurnRequest count" 0 (length requests)

test_when_accept_burn_request_then_holding_burned = script do
  run Test with
    given = given_burn_request_exists
    when = when_accept_burn_request_executed
    then_ = then_holding_burned

-- * Non-member confirm is rejected.

when_outsider_confirms_accept_burn : Fixture -> Script ()
when_outsider_confirms_accept_burn f = do
  proposalInterfaceCid <- proposeAcceptBurn None f
  submitMustFail (memberContext f.parties.outsider f.parties.governanceParty) $
    exerciseCmd f.rulesCid GovernanceRules_ConfirmAction with
      confirmer = f.parties.outsider
      actionProposalCid = proposalInterfaceCid

then_nothing_burn : Fixture -> () -> Script Failures
then_nothing_burn _ _ = pure []

test_when_outsider_confirms_accept_burn_then_rejected = script do
  run Test with
    given = given_burn_request_exists
    when = when_outsider_confirms_accept_burn
    then_ = then_nothing_burn

-- * Block list on. Onboarding created one empty shard per hex prefix, and the
-- request was made before any party was blocked.

given_burn_request_on_block_list : Script Fixture
given_burn_request_on_block_list = do
  parties <- allocateOnboardingTestParties
  rulesCid <- createTestGovernance parties
  artifacts <- setupUtilityForTest parties rulesCid >>= turnBlockListOn parties
  shardCids <- queryBlockListShards parties
  let holder = parties.outsider
      burnAmount = 100.0
  holdingCid <-
    seedHoldingForRequester parties rulesCid artifacts (Some shardCids) holder burnAmount
  burnRequestCid <-
    seedBurnRequest parties artifacts (Some shardCids) holder burnAmount holdingCid
  pure Fixture with ..

-- The holder was blocked after the request, so the factory let it through.
given_burn_request_from_blocked_holder : Script Fixture
given_burn_request_from_blocked_holder = do
  f <- given_burn_request_on_block_list
  blockParty f.parties f.holder
  pure f

when_accept_burn_with_all_shards : Fixture -> Script ()
when_accept_burn_with_all_shards f = do
  shardCids <- queryBlockListShards f.parties
  executeAcceptBurn (Some shardCids) f

when_accept_burn_with_all_shards_fails : Fixture -> Script Text
when_accept_burn_with_all_shards_fails f = do
  shardCids <- queryBlockListShards f.parties
  executeAcceptBurnMustFail (Some shardCids) f

-- The failed accept rolls back, so the locked holding and the request stay.
then_burn_refused : Text -> Fixture -> Text -> Script Failures
then_burn_refused reason f failure = do
  holdings <- query @Holding f.holder
  request <- queryContractId f.parties.governanceParty f.burnRequestCid
  pure $
    shouldContain "execution error" failure reason <>
    shouldBe "holdings for holder" 1 (length holdings) <>
    shouldBe "burn request still open" True (isSome request)

test_when_block_list_on_and_shards_sent_then_holding_burned = script do
  run Test with
    given = given_burn_request_on_block_list
    when = when_accept_burn_with_all_shards
    then_ = then_holding_burned

test_when_holder_blocked_then_burn_refused = script do
  run Test with
    given = given_burn_request_from_blocked_holder
    when = when_accept_burn_with_all_shards_fails
    then_ = then_burn_refused "Holder must not be blocklisted"

test_when_block_list_on_and_no_shards_then_burn_refused = script do
  run Test with
    given = given_burn_request_on_block_list
    when = executeAcceptBurnMustFail None
    then_ = then_burn_refused ("Missing context entry for: " <> blockListContextKey)
