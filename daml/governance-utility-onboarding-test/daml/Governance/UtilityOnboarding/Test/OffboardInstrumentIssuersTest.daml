module Governance.UtilityOnboarding.Test.OffboardInstrumentIssuersTest where

import DA.Set qualified as Set
import Daml.Script

import Utility.Credential.V0.Credential (Claim(..), Credential(..))

import Governance.Action (GovernableAction)
-- Instances only: record-dot access to the execution result's fields.
import Governance.ExecutionResult ()

import Governance.UtilityOnboarding.DualDecpartyTestUtils
import Governance.UtilityOnboarding.OffboardInstrumentIssuers

import TestHarness

data Fixture = Fixture
  with
    f : DualGovFixture
    issuer1CredentialCids : [ContractId Credential]
    issuer2CredentialCids : [ContractId Credential]
  deriving (Eq, Show)

-- | Two issuers credentialed at provisioning; offboarding removes one.
given_two_credentialed_issuers : Script Fixture
given_two_credentialed_issuers = do
  f <- givenDualGovernance
  _ <- setupProvisionedInstrument f [defaultIssuerRequirement f.parties]
    [f.parties.issuer1, f.parties.issuer2]
  issuer1CredentialCids <- map fst <$> query @Credential f.parties.issuer1
  issuer2CredentialCids <- map fst <$> query @Credential f.parties.issuer2
  pure Fixture with ..

offboardProposal
  : Fixture -> [ContractId Credential] -> Script (ContractId GovernableAction)
offboardProposal fx instrumentIssuerCids = do
  proposalCid <- submit fx.f.registrarStack.member1 $ createCmd OffboardInstrumentIssuers with
    governanceParty = fx.f.parties.registrarGov
    proposer = fx.f.registrarStack.member1
    instrumentIssuerCids
  pure (toInterfaceContractId proposalCid)

-- * Happy path: issuer1's credentials revoked, issuer2's untouched.

when_offboard_issuer1 : Fixture -> Script ()
when_offboard_issuer1 fx = do
  proposalCid <- offboardProposal fx fx.issuer1CredentialCids
  _ <- confirmAndExecuteAs fx.f.parties fx.f.registrarStack proposalCid
  pure ()

then_issuer1_revoked_issuer2_kept : Fixture -> () -> Script Failures
then_issuer1_revoked_issuer2_kept fx _ = do
  credentials1 <- query @Credential fx.f.parties.issuer1
  credentials2 <- query @Credential fx.f.parties.issuer2
  pure $
    shouldBe "issuer1 credentials after offboard" 0 (length credentials1) <>
    shouldBe "issuer2 credentials after offboard" 1 (length credentials2)

test_when_offboard_issuer1_then_only_their_credentials_revoked = script do
  run Test with
    given = given_two_credentialed_issuers
    when = when_offboard_issuer1
    then_ = then_issuer1_revoked_issuer2_kept

-- * Credentials of several issuers revoked in one action.

when_offboard_both : Fixture -> Script ()
when_offboard_both fx = do
  proposalCid <- offboardProposal fx
    (fx.issuer1CredentialCids <> fx.issuer2CredentialCids)
  _ <- confirmAndExecuteAs fx.f.parties fx.f.registrarStack proposalCid
  pure ()

then_both_revoked : Fixture -> () -> Script Failures
then_both_revoked fx _ = do
  credentials1 <- query @Credential fx.f.parties.issuer1
  credentials2 <- query @Credential fx.f.parties.issuer2
  pure $
    shouldBe "issuer1 credentials" 0 (length credentials1) <>
    shouldBe "issuer2 credentials" 0 (length credentials2)

test_when_offboard_both_then_all_revoked = script do
  run Test with
    given = given_two_credentialed_issuers
    when = when_offboard_both
    then_ = then_both_revoked

-- * Foreign credential (issuer == holder == outsider): checked fetch fails.
-- registrarGov observes it so the failure is the group check, not visibility.

when_offboard_foreign_credential : Fixture -> Script ()
when_offboard_foreign_credential fx = do
  let parties = fx.f.parties
  foreignCredentialCid <- submit parties.outsider $ createCmd Credential with
    issuer = parties.outsider
    holder = parties.outsider
    id = "foreign-credential"
    description = "Credential issued outside governance"
    validFrom = None
    validUntil = None
    claims = [Claim with
      subject = partyToText parties.issuer1
      property = "role"
      value = "instrument-issuer"]
    observers = Set.fromList [parties.registrarGov]
  proposalCid <- offboardProposal fx [foreignCredentialCid]
  confirmThenExecuteMustFail fx.f.parties fx.f.registrarStack proposalCid

then_nothing : Fixture -> () -> Script Failures
then_nothing _ _ = pure []

test_when_foreign_credential_then_execute_fails = script do
  run Test with
    given = given_two_credentialed_issuers
    when = when_offboard_foreign_credential
    then_ = then_nothing

-- * Claims naming two subjects: the credential identifies no single issuer,
-- so the one-subject assert fails.

when_offboard_mixed_subject_credential : Fixture -> Script ()
when_offboard_mixed_subject_credential fx = do
  let parties = fx.f.parties
  mixedCredentialCid <- submit parties.registrarGov $ createCmd Credential with
    issuer = parties.registrarGov
    holder = parties.registrarGov
    id = "mixed-subject"
    description = "Governance credential naming two subjects"
    validFrom = None
    validUntil = None
    claims =
      [ Claim with
          subject = partyToText parties.issuer1
          property = "role"
          value = "instrument-issuer"
      , Claim with
          subject = partyToText parties.issuer2
          property = "role"
          value = "instrument-issuer"
      ]
    observers = Set.empty
  proposalCid <- offboardProposal fx [mixedCredentialCid]
  confirmThenExecuteMustFail fx.f.parties fx.f.registrarStack proposalCid

test_when_mixed_subject_credential_then_execute_fails = script do
  run Test with
    given = given_two_credentialed_issuers
    when = when_offboard_mixed_subject_credential
    then_ = then_nothing

-- * Claimless credential: attests for nobody, refuse to revoke.

when_offboard_claimless_credential : Fixture -> Script ()
when_offboard_claimless_credential fx = do
  let parties = fx.f.parties
  claimlessCredentialCid <- submit parties.registrarGov $ createCmd Credential with
    issuer = parties.registrarGov
    holder = parties.registrarGov
    id = "claimless"
    description = "Governance credential with no claims"
    validFrom = None
    validUntil = None
    claims = []
    observers = Set.fromList [parties.issuer1]
  proposalCid <- offboardProposal fx [claimlessCredentialCid]
  confirmThenExecuteMustFail fx.f.parties fx.f.registrarStack proposalCid

test_when_claimless_credential_then_execute_fails = script do
  run Test with
    given = given_two_credentialed_issuers
    when = when_offboard_claimless_credential
    then_ = then_nothing

-- * An empty credential list is refused at creation: the template's ensure
-- clause rejects a proposal revoking nothing, so it can never reach a vote.

when_offboard_no_credentials : Fixture -> Script ()
when_offboard_no_credentials fx =
  submitMustFail fx.f.registrarStack.member1 $ createCmd OffboardInstrumentIssuers with
    governanceParty = fx.f.parties.registrarGov
    proposer = fx.f.registrarStack.member1
    instrumentIssuerCids = []

then_both_kept : Fixture -> () -> Script Failures
then_both_kept fx _ = do
  credentials1 <- query @Credential fx.f.parties.issuer1
  credentials2 <- query @Credential fx.f.parties.issuer2
  pure $
    shouldBe "issuer1 credentials kept" 1 (length credentials1) <>
    shouldBe "issuer2 credentials kept" 1 (length credentials2)

test_when_empty_credentials_then_create_fails = script do
  run Test with
    given = given_two_credentialed_issuers
    when = when_offboard_no_credentials
    then_ = then_both_kept

-- * A duplicated credential cid is refused at creation: the second revoke
-- of the same credential would hit an archived contract and fail the whole
-- action at execution, so it can never reach a vote.

when_offboard_duplicate_credentials : Fixture -> Script ()
when_offboard_duplicate_credentials fx =
  submitMustFail fx.f.registrarStack.member1 $ createCmd OffboardInstrumentIssuers with
    governanceParty = fx.f.parties.registrarGov
    proposer = fx.f.registrarStack.member1
    instrumentIssuerCids = fx.issuer1CredentialCids <> fx.issuer1CredentialCids

test_when_duplicate_credentials_then_create_fails = script do
  run Test with
    given = given_two_credentialed_issuers
    when = when_offboard_duplicate_credentials
    then_ = then_both_kept

-- * Non-member confirm is rejected.

when_outsider_confirms : Fixture -> Script ()
when_outsider_confirms fx = do
  proposalCid <- offboardProposal fx fx.issuer1CredentialCids
  outsiderCannotConfirm fx.f.parties fx.f.registrarStack proposalCid

test_when_outsider_confirms_then_rejected = script do
  run Test with
    given = given_two_credentialed_issuers
    when = when_outsider_confirms
    then_ = then_nothing

-- * The description records the revoke count. Execution copies it into the
-- GovernanceExecutionResult; the offboarded parties are read from the
-- revoked credentials' claims, not from the proposal.

when_offboard_both_capturing_description : Fixture -> Script Text
when_offboard_both_capturing_description fx = do
  proposalCid <- offboardProposal fx
    (fx.issuer1CredentialCids <> fx.issuer2CredentialCids)
  result <- confirmAndExecuteAs fx.f.parties fx.f.registrarStack proposalCid
  Some executionResult <-
    queryContractId fx.f.parties.registrarGov result.executionResultCid
  pure executionResult.description

-- The expected text is spelled out so the test fails if the template's
-- wording changes.
then_description_records_count : Fixture -> Text -> Script Failures
then_description_records_count _ description =
  pure $ shouldBe "executed description"
    "Offboard instrument issuers (revoke 2 credentials)"
    description

test_when_offboard_then_description_records_count = script do
  run Test with
    given = given_two_credentialed_issuers
    when = when_offboard_both_capturing_description
    then_ = then_description_records_count
