-- | These tests cover ProvisionInstrument: the happy path, the claimless,
-- duplicate-issuer and nonce ensure guards, the proposer-owned-service
-- check, the credential id layout with and without a nonce, the
-- credential validity window and the block list flag.
module Governance.UtilityOnboarding.Test.ProvisionInstrumentTest where

import DA.Assert ((===))
import DA.Date (Month(Jan), date)
import DA.Text qualified as Text
import DA.Time (addRelTime, convertRelTimeToMicroseconds, days, seconds, subTime, time)
import Daml.Script

import Utility.Credential.V0.Credential (Claim(..), Credential(..), PartyCredentialRequirement(..))
import Utility.Registry.App.V0.Service.Registrar (RegistrarService(..))
import Utility.Registry.V0.Configuration.Instrument (InstrumentConfiguration(..))

import Governance.Action (GovernableAction)
-- Instances only: record-dot access to the execution result's fields.
import Governance.ExecutionResult ()

import Governance.UtilityOnboarding.DualDecpartyTestUtils
import Governance.UtilityOnboarding.ProvisionInstrument
import Governance.UtilityOnboarding.Utils (blockListText, credentialValidityText, mkCredentialId)

import TestHarness

data Fixture = Fixture
  with
    f : DualGovFixture
    onboarded : OnboardedRegistrarArtifacts
  deriving (Eq, Show)

given_onboarded_registrar : Script Fixture
given_onboarded_registrar = do
  f <- givenDualGovernance
  onboarded <- setupOnboardedRegistrar f [defaultRegistrarRequirement f.parties]
  pure Fixture with ..

provisionProposal
  : Fixture -> [PartyCredentialRequirement] -> [Party] -> Script (ContractId GovernableAction)
provisionProposal fx = provisionProposalWithNonce fx provisionInstrumentNonce

provisionProposalWithNonce
  : Fixture -> Optional Text -> [PartyCredentialRequirement] -> [Party]
  -> Script (ContractId GovernableAction)
provisionProposalWithNonce fx credentialIdNonce issuerRequirements initialInstrumentIssuers = do
  proposalCid <- submit fx.f.registrarStack.member1 $ createCmd ProvisionInstrument with
    governanceParty = fx.f.parties.registrarGov
    proposer = fx.f.registrarStack.member1
    registrarServiceCid = fx.onboarded.registrarServiceCid
    instrumentIdText = "LAUNCH-TOKEN"
    additionalIdentifiers = []
    issuerRequirements
    holderRequirements = []
    initialInstrumentIssuers
    credentialIdNonce
    credentialValidFrom = None
    credentialValidUntil = None
    useBlockList = None
  pure (toInterfaceContractId proposalCid)

-- * Happy path: configuration created, initial issuer credentialed.

when_provision_with_initial_issuer : Fixture -> Script ()
when_provision_with_initial_issuer fx = do
  proposalCid <- provisionProposal fx
    [defaultIssuerRequirement fx.f.parties] [fx.f.parties.issuer1]
  _ <- confirmAndExecuteAs fx.f.parties fx.f.registrarStack proposalCid
  pure ()

then_configuration_and_credential_created : Fixture -> () -> Script Failures
then_configuration_and_credential_created fx _ = do
  let parties = fx.f.parties
  configurations <- query @InstrumentConfiguration parties.registrarGov
  issuerCredentials <- query @Credential parties.issuer1
  -- Script time is static, so getTime here equals the mint-time timestamp.
  now <- getTime
  let configurationChecks = case configurations of
        [(_, configuration)] ->
          shouldBe "issuerRequirements"
            [defaultIssuerRequirement parties] configuration.issuerRequirements <>
          shouldBe "registrar" parties.registrarGov configuration.registrar <>
          shouldBe "defaultIdentifier.id" "LAUNCH-TOKEN" configuration.defaultIdentifier.id
        _ -> shouldBe "InstrumentConfiguration count" 1 (length configurations)
      credentialChecks = case issuerCredentials of
        [(_, credential)] ->
          shouldBe "credential.issuer" parties.registrarGov credential.issuer <>
          shouldBe "credential.holder" parties.registrarGov credential.holder <>
          shouldBe "credential.id"
            (mkCredentialId "LAUNCH-TOKEN-instrument-issuer-credential" parties.issuer1 now
              provisionInstrumentNonce 0)
            credential.id <>
          shouldBe "credential.claims"
            [Claim with
               subject = partyToText parties.issuer1
               property = "role"
               value = "instrument-issuer"]
            credential.claims
        _ -> shouldBe "Credential count seen by issuer1" 1 (length issuerCredentials)
  pure $ configurationChecks <> credentialChecks

test_when_provision_then_configuration_and_credential = script do
  run Test with
    given = given_onboarded_registrar
    when = when_provision_with_initial_issuer
    then_ = then_configuration_and_credential_created

-- * No initial issuers: configuration only.

when_provision_without_issuers : Fixture -> Script ()
when_provision_without_issuers fx = do
  proposalCid <- provisionProposal fx [defaultIssuerRequirement fx.f.parties] []
  _ <- confirmAndExecuteAs fx.f.parties fx.f.registrarStack proposalCid
  pure ()

then_no_issuer_credentials : Fixture -> () -> Script Failures
then_no_issuer_credentials fx _ = do
  configurations <- query @InstrumentConfiguration fx.f.parties.registrarGov
  credentials1 <- query @Credential fx.f.parties.issuer1
  credentials2 <- query @Credential fx.f.parties.issuer2
  pure $
    shouldBe "InstrumentConfiguration count" 1 (length configurations) <>
    shouldBe "issuer1 credentials" 0 (length credentials1) <>
    shouldBe "issuer2 credentials" 0 (length credentials2)

test_when_no_initial_issuers_then_no_credentials = script do
  run Test with
    given = given_onboarded_registrar
    when = when_provision_without_issuers
    then_ = then_no_issuer_credentials

-- * Mixed requirements: only the self-issuable one is minted.

when_provision_mixed_requirements : Fixture -> Script ()
when_provision_mixed_requirements fx = do
  let externalRequirement = PartyCredentialRequirement with
        issuer = fx.f.parties.outsider
        requiredClaims = [("audit", "done")]
  proposalCid <- provisionProposal fx
    [defaultIssuerRequirement fx.f.parties, externalRequirement] [fx.f.parties.issuer1]
  _ <- confirmAndExecuteAs fx.f.parties fx.f.registrarStack proposalCid
  pure ()

then_only_self_issuable_minted : Fixture -> () -> Script Failures
then_only_self_issuable_minted fx _ = do
  credentials <- query @Credential fx.f.parties.issuer1
  case credentials of
    [(_, credential)] -> pure $
      shouldBe "credential.issuer" fx.f.parties.registrarGov credential.issuer
    _ -> pure $ shouldBe "Credential count for issuer1" 1 (length credentials)

test_when_mixed_requirements_then_only_self_issuable_minted = script do
  run Test with
    given = given_onboarded_registrar
    when = when_provision_mixed_requirements
    then_ = then_only_self_issuable_minted

-- * A self-issuable requirement with no claims is refused at creation:
-- the ensure clause rejects the proposal before any vote. This matters
-- most with no initial issuers — the mint assert would never run, so the
-- configuration would otherwise persist and fail every later onboard.

when_provision_claimless_requirement : Fixture -> Script ()
when_provision_claimless_requirement fx =
  submitMustFail fx.f.registrarStack.member1 $ createCmd ProvisionInstrument with
    governanceParty = fx.f.parties.registrarGov
    proposer = fx.f.registrarStack.member1
    registrarServiceCid = fx.onboarded.registrarServiceCid
    instrumentIdText = "LAUNCH-TOKEN"
    additionalIdentifiers = []
    issuerRequirements = [PartyCredentialRequirement with
      issuer = fx.f.parties.registrarGov
      requiredClaims = []]
    holderRequirements = []
    initialInstrumentIssuers = []
    credentialIdNonce = None
    credentialValidFrom = None
    credentialValidUntil = None
    useBlockList = None

then_nothing_provisioned : Fixture -> () -> Script Failures
then_nothing_provisioned fx _ = do
  configurations <- query @InstrumentConfiguration fx.f.parties.registrarGov
  pure $ shouldBe "InstrumentConfiguration count" 0 (length configurations)

test_when_claimless_self_requirement_then_create_fails = script do
  run Test with
    given = given_onboarded_registrar
    when = when_provision_claimless_requirement
    then_ = then_nothing_provisioned

-- * The ensure clause is narrow: a claimless requirement from an external
-- issuer is legal. The mint helper skips external requirements, so the
-- provision succeeds and mints nothing for it.

when_provision_claimless_external_requirement : Fixture -> Script ()
when_provision_claimless_external_requirement fx = do
  let externalClaimless = PartyCredentialRequirement with
        issuer = fx.f.parties.outsider
        requiredClaims = []
  proposalCid <- provisionProposal fx [externalClaimless] [fx.f.parties.issuer1]
  _ <- confirmAndExecuteAs fx.f.parties fx.f.registrarStack proposalCid
  pure ()

then_configuration_created_nothing_minted : Fixture -> () -> Script Failures
then_configuration_created_nothing_minted fx _ = do
  configurations <- query @InstrumentConfiguration fx.f.parties.registrarGov
  credentials <- query @Credential fx.f.parties.issuer1
  pure $
    shouldBe "InstrumentConfiguration count" 1 (length configurations) <>
    shouldBe "issuer1 credentials" 0 (length credentials)

test_when_claimless_external_requirement_then_provisioned = script do
  run Test with
    given = given_onboarded_registrar
    when = when_provision_claimless_external_requirement
    then_ = then_configuration_created_nothing_minted

-- * The ensure clause is narrow: holder requirements are never minted
-- against, so a claimless self-issued holder requirement is legal.

when_provision_claimless_holder_requirement : Fixture -> Script ()
when_provision_claimless_holder_requirement fx = do
  proposalCid <- submit fx.f.registrarStack.member1 $ createCmd ProvisionInstrument with
    governanceParty = fx.f.parties.registrarGov
    proposer = fx.f.registrarStack.member1
    registrarServiceCid = fx.onboarded.registrarServiceCid
    instrumentIdText = "LAUNCH-TOKEN"
    additionalIdentifiers = []
    issuerRequirements = [defaultIssuerRequirement fx.f.parties]
    holderRequirements = [PartyCredentialRequirement with
      issuer = fx.f.parties.registrarGov
      requiredClaims = []]
    initialInstrumentIssuers = []
    credentialIdNonce = None
    credentialValidFrom = None
    credentialValidUntil = None
    useBlockList = None
  let proposalInterfaceCid : ContractId GovernableAction = toInterfaceContractId proposalCid
  _ <- confirmAndExecuteAs fx.f.parties fx.f.registrarStack proposalInterfaceCid
  pure ()

then_configuration_created : Fixture -> () -> Script Failures
then_configuration_created fx _ = do
  configurations <- query @InstrumentConfiguration fx.f.parties.registrarGov
  pure $ shouldBe "InstrumentConfiguration count" 1 (length configurations)

test_when_claimless_self_holder_requirement_then_provisioned = script do
  run Test with
    given = given_onboarded_registrar
    when = when_provision_claimless_holder_requirement
    then_ = then_configuration_created

-- * Authorization: a service owned by the proposer, not the governance
-- party, is refused. Controller authorization alone does not protect this:
-- the proposer's authority is in scope during execution, so a proposer who
-- self-issues a RegistrarService could otherwise provision against it and
-- mint real governance-issued credentials. The registrar assert stops it.

when_provision_against_proposer_owned_service : Fixture -> Script ()
when_provision_against_proposer_owned_service fx = do
  let parties = fx.f.parties
      proposer = fx.f.registrarStack.member1
  foreignServiceCid <- submit proposer $ createCmd RegistrarService with
    operator = parties.registrarGov
    provider = proposer
    registrar = proposer
    enableResultContracts = None
  proposalCid <- submit proposer $ createCmd ProvisionInstrument with
    governanceParty = parties.registrarGov
    proposer
    registrarServiceCid = foreignServiceCid
    instrumentIdText = "LAUNCH-TOKEN"
    additionalIdentifiers = []
    issuerRequirements = [defaultIssuerRequirement parties]
    holderRequirements = []
    initialInstrumentIssuers = [parties.issuer1]
    credentialIdNonce = None
    credentialValidFrom = None
    credentialValidUntil = None
    useBlockList = None
  confirmThenExecuteMustFail fx.f.parties fx.f.registrarStack (toInterfaceContractId proposalCid)

then_no_credentials_minted : Fixture -> () -> Script Failures
then_no_credentials_minted fx _ = do
  credentials <- query @Credential fx.f.parties.issuer1
  pure $ shouldBe "issuer1 credentials" 0 (length credentials)

test_when_proposer_owned_service_then_execute_fails = script do
  run Test with
    given = given_onboarded_registrar
    when = when_provision_against_proposer_owned_service
    then_ = then_no_credentials_minted

-- * Non-member confirm is rejected.

when_outsider_confirms : Fixture -> Script ()
when_outsider_confirms fx = do
  proposalCid <- provisionProposal fx [] []
  outsiderCannotConfirm fx.f.parties fx.f.registrarStack proposalCid

then_nothing : Fixture -> () -> Script Failures
then_nothing _ _ = pure []

test_when_outsider_confirms_then_rejected = script do
  run Test with
    given = given_onboarded_registrar
    when = when_outsider_confirms
    then_ = then_nothing

-- * The description names the instrument and the initial issuers. Voters
-- confirm from this text alone, and execution copies it into the
-- GovernanceExecutionResult.

when_provision_capturing_description : Fixture -> Script Text
when_provision_capturing_description fx = do
  proposalCid <- provisionProposal fx
    [defaultIssuerRequirement fx.f.parties] [fx.f.parties.issuer1]
  result <- confirmAndExecuteAs fx.f.parties fx.f.registrarStack proposalCid
  Some executionResult <-
    queryContractId fx.f.parties.registrarGov result.executionResultCid
  pure executionResult.description

-- The expected text is spelled out with stdlib `show` and literal joins,
-- so the test fails if the template's wording changes.
then_description_names_instrument_and_issuer : Fixture -> Text -> Script Failures
then_description_names_instrument_and_issuer fx description =
  pure $ shouldBe "executed description"
    ("Provision instrument LAUNCH-TOKEN, initial issuers "
       <> show fx.f.parties.issuer1)
    description

test_when_provision_then_description_names_issuers = script do
  run Test with
    given = given_onboarded_registrar
    when = when_provision_capturing_description
    then_ = then_description_names_instrument_and_issuer

-- * A duplicated initial issuer is refused at creation: two mints for the
-- same subject in one transaction would share a credential id, leaving
-- rows the offboard picker cannot tell apart.

when_provision_duplicate_initial_issuers : Fixture -> Script ()
when_provision_duplicate_initial_issuers fx =
  submitMustFail fx.f.registrarStack.member1 $ createCmd ProvisionInstrument with
    governanceParty = fx.f.parties.registrarGov
    proposer = fx.f.registrarStack.member1
    registrarServiceCid = fx.onboarded.registrarServiceCid
    instrumentIdText = "LAUNCH-TOKEN"
    additionalIdentifiers = []
    issuerRequirements = [defaultIssuerRequirement fx.f.parties]
    holderRequirements = []
    initialInstrumentIssuers = [fx.f.parties.issuer1, fx.f.parties.issuer1]
    credentialIdNonce = None
    credentialValidFrom = None
    credentialValidUntil = None
    useBlockList = None

test_when_duplicate_initial_issuers_then_create_fails = script do
  run Test with
    given = given_onboarded_registrar
    when = when_provision_duplicate_initial_issuers
    then_ = then_nothing_provisioned

-- * Credential ids are instrument-scoped: the first "/" segment is
-- "{symbol}-instrument-issuer-credential". Asserted on the raw id text,
-- not via mkCredentialId, so the format itself is pinned.

then_credential_id_is_instrument_scoped : Fixture -> () -> Script Failures
then_credential_id_is_instrument_scoped fx _ = do
  credentials <- query @Credential fx.f.parties.issuer1
  case credentials of
    [(_, credential)] -> pure $
      shouldBe "credential id first segment"
        ["LAUNCH-TOKEN-instrument-issuer-credential"]
        (take 1 (Text.splitOn "/" credential.id))
    _ -> pure $ shouldBe "Credential count for issuer1" 1 (length credentials)

test_when_provision_then_credential_id_is_instrument_scoped = script do
  run Test with
    given = given_onboarded_registrar
    when = when_provision_with_initial_issuer
    then_ = then_credential_id_is_instrument_scoped

-- * Credential id layout, asserted on the raw id text rather than via
-- mkCredentialId so the format itself is pinned. The third "/" segment is
-- "{seconds}-{nonce}-{index}" with a nonce and "{seconds}-{index}" without
-- one. A proposal created under an earlier package version upgrades with
-- None, so the nonce-free form keeps the layout those versions minted.

when_provision_with_nonce : Fixture -> Script ()
when_provision_with_nonce fx = do
  proposalCid <- provisionProposalWithNonce fx (Some "n0nce")
    [defaultIssuerRequirement fx.f.parties] [fx.f.parties.issuer1]
  _ <- confirmAndExecuteAs fx.f.parties fx.f.registrarStack proposalCid
  pure ()

when_provision_without_nonce : Fixture -> Script ()
when_provision_without_nonce fx = do
  proposalCid <- provisionProposalWithNonce fx None
    [defaultIssuerRequirement fx.f.parties] [fx.f.parties.issuer1]
  _ <- confirmAndExecuteAs fx.f.parties fx.f.registrarStack proposalCid
  pure ()

-- | Assert issuer1 holds one credential whose id splits on "/" into the
-- role tag, issuer1, and the given timestamp segment. Script time is
-- static, so getTime here equals the mint-time timestamp.
issuer1CredentialIdIs : Fixture -> (Text -> Text) -> Script Failures
issuer1CredentialIdIs fx timestampSegment = do
  now <- getTime
  let seconds = show
        (convertRelTimeToMicroseconds (subTime now (time (date 1970 Jan 1) 0 0 0)) / 1000000)
  credentials <- query @Credential fx.f.parties.issuer1
  case credentials of
    [(_, credential)] -> pure $
      shouldBe "credential id segments"
        [ "LAUNCH-TOKEN-instrument-issuer-credential"
        , partyToText fx.f.parties.issuer1
        , timestampSegment seconds ]
        (Text.splitOn "/" credential.id)
    _ -> pure $ shouldBe "Credential count for issuer1" 1 (length credentials)

then_credential_id_carries_nonce : Fixture -> () -> Script Failures
then_credential_id_carries_nonce fx _ =
  issuer1CredentialIdIs fx (<> "-n0nce-0")

test_when_nonce_then_credential_id_carries_it = script do
  run Test with
    given = given_onboarded_registrar
    when = when_provision_with_nonce
    then_ = then_credential_id_carries_nonce

then_credential_id_has_no_nonce : Fixture -> () -> Script Failures
then_credential_id_has_no_nonce fx _ =
  issuer1CredentialIdIs fx (<> "-0")

test_when_no_nonce_then_credential_id_has_legacy_format = script do
  run Test with
    given = given_onboarded_registrar
    when = when_provision_without_nonce
    then_ = then_credential_id_has_no_nonce

-- * A malformed nonce is refused at creation, before any vote. An empty
-- nonce would render as "{seconds}--{index}", and a "/" would shift the
-- id segments that readers split on.

proposeWithNonceMustFail : Fixture -> Optional Text -> Script ()
proposeWithNonceMustFail fx credentialIdNonce =
  submitMustFail fx.f.registrarStack.member1 $ createCmd ProvisionInstrument with
    governanceParty = fx.f.parties.registrarGov
    proposer = fx.f.registrarStack.member1
    registrarServiceCid = fx.onboarded.registrarServiceCid
    instrumentIdText = "LAUNCH-TOKEN"
    additionalIdentifiers = []
    issuerRequirements = [defaultIssuerRequirement fx.f.parties]
    holderRequirements = []
    initialInstrumentIssuers = [fx.f.parties.issuer1]
    credentialIdNonce
    credentialValidFrom = None
    credentialValidUntil = None
    useBlockList = None

when_propose_with_empty_nonce : Fixture -> Script ()
when_propose_with_empty_nonce fx = proposeWithNonceMustFail fx (Some "")

test_when_nonce_empty_then_create_fails = script do
  run Test with
    given = given_onboarded_registrar
    when = when_propose_with_empty_nonce
    then_ = then_nothing_provisioned

when_propose_with_slash_nonce : Fixture -> Script ()
when_propose_with_slash_nonce fx = proposeWithNonceMustFail fx (Some "a/b")

test_when_nonce_has_slash_then_create_fails = script do
  run Test with
    given = given_onboarded_registrar
    when = when_propose_with_slash_nonce
    then_ = then_nothing_provisioned

-- * Credential validity window. The proposal's window is copied onto every
-- credential it mints. Without one the credentials never expire, which is
-- what every earlier package version minted (#346).

provisionProposalWithValidity
  : Fixture -> Optional Time -> Optional Time -> Script (ContractId GovernableAction)
provisionProposalWithValidity fx credentialValidFrom credentialValidUntil = do
  proposalCid <- submit fx.f.registrarStack.member1 $ createCmd ProvisionInstrument with
    governanceParty = fx.f.parties.registrarGov
    proposer = fx.f.registrarStack.member1
    registrarServiceCid = fx.onboarded.registrarServiceCid
    instrumentIdText = "LAUNCH-TOKEN"
    additionalIdentifiers = []
    issuerRequirements = [defaultIssuerRequirement fx.f.parties]
    holderRequirements = []
    initialInstrumentIssuers = [fx.f.parties.issuer1]
    credentialIdNonce = provisionInstrumentNonce
    credentialValidFrom
    credentialValidUntil
    useBlockList = None
  pure (toInterfaceContractId proposalCid)

-- | Assert issuer1 holds one credential with the given window.
issuer1CredentialValidityIs : Fixture -> Optional Time -> Optional Time -> Script Failures
issuer1CredentialValidityIs fx validFrom validUntil = do
  credentials <- query @Credential fx.f.parties.issuer1
  case credentials of
    [(_, credential)] -> pure $
      shouldBe "credential.validFrom" validFrom credential.validFrom <>
      shouldBe "credential.validUntil" validUntil credential.validUntil
    _ -> pure $ shouldBe "Credential count for issuer1" 1 (length credentials)

when_provision_with_validity_window : Fixture -> Script ()
when_provision_with_validity_window fx = do
  now <- getTime
  proposalCid <- provisionProposalWithValidity fx
    (Some (addRelTime now (days (-1)))) (Some (addRelTime now (days 30)))
  _ <- confirmAndExecuteAs fx.f.parties fx.f.registrarStack proposalCid
  pure ()

-- Script time is static, so getTime here equals the time the window was
-- built from.
then_credential_carries_validity_window : Fixture -> () -> Script Failures
then_credential_carries_validity_window fx _ = do
  now <- getTime
  issuer1CredentialValidityIs fx
    (Some (addRelTime now (days (-1)))) (Some (addRelTime now (days 30)))

test_when_validity_window_then_credential_carries_it = script do
  run Test with
    given = given_onboarded_registrar
    when = when_provision_with_validity_window
    then_ = then_credential_carries_validity_window

when_provision_with_expiry_only : Fixture -> Script ()
when_provision_with_expiry_only fx = do
  now <- getTime
  proposalCid <- provisionProposalWithValidity fx None (Some (addRelTime now (days 30)))
  _ <- confirmAndExecuteAs fx.f.parties fx.f.registrarStack proposalCid
  pure ()

then_credential_expires_only : Fixture -> () -> Script Failures
then_credential_expires_only fx _ = do
  now <- getTime
  issuer1CredentialValidityIs fx None (Some (addRelTime now (days 30)))

test_when_expiry_only_then_credential_valid_from_creation = script do
  run Test with
    given = given_onboarded_registrar
    when = when_provision_with_expiry_only
    then_ = then_credential_expires_only

then_credential_never_expires : Fixture -> () -> Script Failures
then_credential_never_expires fx _ = issuer1CredentialValidityIs fx None None

test_when_no_validity_window_then_credential_never_expires = script do
  run Test with
    given = given_onboarded_registrar
    when = when_provision_with_initial_issuer
    then_ = then_credential_never_expires

-- * A window that starts at or after its end is refused at creation, before
-- any vote.

proposeWithValidityMustFail : Fixture -> Optional Time -> Optional Time -> Script ()
proposeWithValidityMustFail fx credentialValidFrom credentialValidUntil =
  submitMustFail fx.f.registrarStack.member1 $ createCmd ProvisionInstrument with
    governanceParty = fx.f.parties.registrarGov
    proposer = fx.f.registrarStack.member1
    registrarServiceCid = fx.onboarded.registrarServiceCid
    instrumentIdText = "LAUNCH-TOKEN"
    additionalIdentifiers = []
    issuerRequirements = [defaultIssuerRequirement fx.f.parties]
    holderRequirements = []
    initialInstrumentIssuers = [fx.f.parties.issuer1]
    credentialIdNonce = provisionInstrumentNonce
    credentialValidFrom
    credentialValidUntil
    useBlockList = None

when_propose_with_empty_window : Fixture -> Script ()
when_propose_with_empty_window fx = do
  now <- getTime
  let at = addRelTime now (days 1)
  proposeWithValidityMustFail fx (Some at) (Some at)

when_propose_with_inverted_window : Fixture -> Script ()
when_propose_with_inverted_window fx = do
  now <- getTime
  proposeWithValidityMustFail fx
    (Some (addRelTime now (days 2))) (Some (addRelTime now (days 1)))

test_when_window_is_empty_then_proposal_refused = script do
  run Test with
    given = given_onboarded_registrar
    when = when_propose_with_empty_window
    then_ = then_nothing_provisioned

test_when_window_is_inverted_then_proposal_refused = script do
  run Test with
    given = given_onboarded_registrar
    when = when_propose_with_inverted_window
    then_ = then_nothing_provisioned

-- * A window that has already ended by execution is refused at execution:
-- the ensure clause cannot read the ledger clock, so it passes the vote,
-- and execution would otherwise mint credentials expired on creation.

when_execute_after_window_ended : Fixture -> Script ()
when_execute_after_window_ended fx = do
  now <- getTime
  proposalCid <- provisionProposalWithValidity fx None (Some (addRelTime now (seconds (-1))))
  confirmThenExecuteMustFail fx.f.parties fx.f.registrarStack proposalCid

-- The refused execution rolls back whole: no configuration, no credential.
then_nothing_provisioned_or_minted : Fixture -> () -> Script Failures
then_nothing_provisioned_or_minted fx _ = do
  credentials <- query @Credential fx.f.parties.issuer1
  nothingProvisioned <- then_nothing_provisioned fx ()
  pure $ nothingProvisioned <>
    shouldBe "issuer1 credentials" 0 (length credentials)

test_when_window_ended_then_execution_refused = script do
  run Test with
    given = given_onboarded_registrar
    when = when_execute_after_window_ended
    then_ = then_nothing_provisioned_or_minted

-- * Voters see only the description, so it states the window.

test_validity_text_states_the_window = script do
  let t1 = time (date 2027 Jan 1) 0 0 0
      t2 = time (date 2027 Jan 31) 0 0 0
  credentialValidityText None None === ""
  credentialValidityText None (Some t2) === ("; credentials valid until " <> show t2)
  credentialValidityText (Some t1) None === ("; credentials valid from " <> show t1)
  credentialValidityText (Some t1) (Some t2)
    === ("; credentials valid from " <> show t1 <> " until " <> show t2)

-- The executed description carries the window when the action mints for
-- initial issuers, and leaves it out when there are none, since then
-- nothing is minted for it to limit.

provisionWithExpiryCapturingDescription : Fixture -> [Party] -> Script Text
provisionWithExpiryCapturingDescription fx initialInstrumentIssuers = do
  now <- getTime
  proposalCid <- submit fx.f.registrarStack.member1 $ createCmd ProvisionInstrument with
    governanceParty = fx.f.parties.registrarGov
    proposer = fx.f.registrarStack.member1
    registrarServiceCid = fx.onboarded.registrarServiceCid
    instrumentIdText = "LAUNCH-TOKEN"
    additionalIdentifiers = []
    issuerRequirements = [defaultIssuerRequirement fx.f.parties]
    holderRequirements = []
    initialInstrumentIssuers
    credentialIdNonce = provisionInstrumentNonce
    credentialValidFrom = None
    credentialValidUntil = Some (addRelTime now (days 30))
    useBlockList = None
  result <- confirmAndExecuteAs fx.f.parties fx.f.registrarStack (toInterfaceContractId proposalCid)
  Some executionResult <-
    queryContractId fx.f.parties.registrarGov result.executionResultCid
  pure executionResult.description

when_provision_issuer_with_expiry_capturing_description : Fixture -> Script Text
when_provision_issuer_with_expiry_capturing_description fx =
  provisionWithExpiryCapturingDescription fx [fx.f.parties.issuer1]

-- Script time is static, so getTime here equals the time the expiry was
-- built from.
then_description_states_the_expiry : Fixture -> Text -> Script Failures
then_description_states_the_expiry fx description = do
  now <- getTime
  pure $ shouldBe "executed description"
    ("Provision instrument LAUNCH-TOKEN, initial issuers "
       <> show fx.f.parties.issuer1
       <> "; credentials valid until " <> show (addRelTime now (days 30)))
    description

test_when_issuers_and_expiry_then_description_states_it = script do
  run Test with
    given = given_onboarded_registrar
    when = when_provision_issuer_with_expiry_capturing_description
    then_ = then_description_states_the_expiry

when_provision_no_issuers_with_expiry_capturing_description : Fixture -> Script Text
when_provision_no_issuers_with_expiry_capturing_description fx =
  provisionWithExpiryCapturingDescription fx []

then_description_has_no_window : Fixture -> Text -> Script Failures
then_description_has_no_window _ description =
  pure $ shouldBe "executed description"
    "Provision instrument LAUNCH-TOKEN, no initial issuers"
    description

test_when_no_issuers_then_description_has_no_window = script do
  run Test with
    given = given_onboarded_registrar
    when = when_provision_no_issuers_with_expiry_capturing_description
    then_ = then_description_has_no_window

-- * useBlockList becomes the configuration's checkBlockList. None is what
-- earlier package versions passed, and it leaves the check off. Voters see
-- only the description, so it states a set flag.

provisionWithBlockListCapturingDescription : Optional Bool -> Fixture -> Script Text
provisionWithBlockListCapturingDescription useBlockList fx = do
  proposalCid <- submit fx.f.registrarStack.member1 $ createCmd ProvisionInstrument with
    governanceParty = fx.f.parties.registrarGov
    proposer = fx.f.registrarStack.member1
    registrarServiceCid = fx.onboarded.registrarServiceCid
    instrumentIdText = "LAUNCH-TOKEN"
    additionalIdentifiers = []
    issuerRequirements = [defaultIssuerRequirement fx.f.parties]
    holderRequirements = []
    initialInstrumentIssuers = []
    credentialIdNonce = provisionInstrumentNonce
    credentialValidFrom = None
    credentialValidUntil = None
    useBlockList
  result <- confirmAndExecuteAs fx.f.parties fx.f.registrarStack (toInterfaceContractId proposalCid)
  Some executionResult <-
    queryContractId fx.f.parties.registrarGov result.executionResultCid
  pure executionResult.description

then_block_list_flag_is : Optional Bool -> Text -> Fixture -> Text -> Script Failures
then_block_list_flag_is expectedFlag expectedDescription fx description = do
  configurations <- query @InstrumentConfiguration fx.f.parties.registrarGov
  pure $
    shouldBe "checkBlockList" [expectedFlag] (map ((.checkBlockList) . snd) configurations) <>
    shouldBe "executed description" expectedDescription description

test_when_block_list_unset_then_check_off = script do
  run Test with
    given = given_onboarded_registrar
    when = provisionWithBlockListCapturingDescription None
    then_ = then_block_list_flag_is None
      "Provision instrument LAUNCH-TOKEN, no initial issuers"

test_when_block_list_on_then_check_on = script do
  run Test with
    given = given_onboarded_registrar
    when = provisionWithBlockListCapturingDescription (Some True)
    then_ = then_block_list_flag_is (Some True)
      "Provision instrument LAUNCH-TOKEN, no initial issuers; block list on"

test_block_list_text_states_the_flag = script do
  blockListText None === ""
  blockListText (Some True) === "; block list on"
  blockListText (Some False) === "; block list off"
