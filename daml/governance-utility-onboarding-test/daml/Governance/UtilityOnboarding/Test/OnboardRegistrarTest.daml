module Governance.UtilityOnboarding.Test.OnboardRegistrarTest where

import DA.Set qualified as Set
import Daml.Script

import Utility.Credential.V0.Credential (Claim(..), Credential(..), PartyCredentialRequirement(..))
import Utility.Registry.App.V0.Service.AllocationFactory (AllocationFactory)
import Utility.Registry.App.V0.Service.Provider (ProviderService)
import Utility.Registry.App.V0.Configuration.Provider (ProviderConfiguration(..))
import Utility.Registry.App.V0.Service.Registrar (RegistrarService(..), RegistrarServiceRequest(..))
import Utility.Registry.V0.Rule.Transfer (TransferRule)

import Governance.Action (GovernableAction)

import Governance.UtilityOnboarding.DualDecpartyTestUtils
import Governance.UtilityOnboarding.OnboardRegistrar

import TestHarness

data Fixture = Fixture
  with
    f : DualGovFixture
    providerServiceCid : ContractId ProviderService
    providerConfigurationCid : ContractId ProviderConfiguration
    requestCid : ContractId RegistrarServiceRequest
  deriving (Eq, Show)

onboardProposal : Fixture -> Party -> Script (ContractId GovernableAction)
onboardProposal fx registrar = do
  proposalCid <- submit fx.f.providerStack.member1 $ createCmd OnboardRegistrar with
    governanceParty = fx.f.parties.providerGov
    proposer = fx.f.providerStack.member1
    registrar
    providerServiceCid = fx.providerServiceCid
    registrarServiceRequestCid = fx.requestCid
    providerConfigurationCid = fx.providerConfigurationCid
    extraRegistrarCredentialCids = []
  pure (toInterfaceContractId proposalCid)

-- * Happy path: credential minted, service created, request consumed.

given_with_default_requirement : Script Fixture
given_with_default_requirement = do
  f <- givenDualGovernance
  providerServiceCid <- setupProviderService f.parties
  providerConfigurationCid <- setupProviderConfiguration f providerServiceCid
    [defaultRegistrarRequirement f.parties] []
  requestCid <- setupRegistrarServiceRequest f
  pure Fixture with ..

when_onboard_registrar : Fixture -> Script ()
when_onboard_registrar fx = do
  proposalCid <- onboardProposal fx fx.f.parties.registrarGov
  _ <- confirmAndExecuteAs fx.f.parties fx.f.providerStack proposalCid
  pure ()

then_registrar_onboarded : Fixture -> () -> Script Failures
then_registrar_onboarded fx _ = do
  let parties = fx.f.parties
  services <- query @RegistrarService parties.registrarGov
  factories <- query @AllocationFactory parties.registrarGov
  transferRules <- query @TransferRule parties.registrarGov
  remainingRequests <- query @RegistrarServiceRequest parties.registrarGov
  -- Registrar visibility of the minted credential proves the observer wiring.
  credentials <- query @Credential parties.registrarGov
  let serviceChecks = case services of
        [(_, service)] ->
          shouldBe "service.registrar" parties.registrarGov service.registrar <>
          shouldBe "service.provider" parties.providerGov service.provider <>
          shouldBe "service.operator" parties.operator service.operator
        _ -> shouldBe "RegistrarService count" 1 (length services)
      credentialChecks = case credentials of
        [(_, credential)] ->
          shouldBe "credential.issuer" parties.providerGov credential.issuer <>
          shouldBe "credential.holder" parties.providerGov credential.holder <>
          shouldBe "credential.id"
            ("registrar-credential/" <> partyToText parties.registrarGov <> "/0")
            credential.id <>
          shouldBe "credential.claims"
            [Claim with
               subject = partyToText parties.registrarGov
               property = "role"
               value = "registrar"]
            credential.claims <>
          shouldBe "credential.observers" (Set.fromList [parties.registrarGov])
            credential.observers <>
          shouldBe "credential.validFrom" None credential.validFrom <>
          shouldBe "credential.validUntil" None credential.validUntil
        _ -> shouldBe "Credential count seen by registrar" 1 (length credentials)
  pure $
    serviceChecks <>
    credentialChecks <>
    shouldBe "AllocationFactory count" 1 (length factories) <>
    shouldBe "TransferRule count" 1 (length transferRules) <>
    shouldBe "request archived" 0 (length remainingRequests)

test_when_onboard_registrar_then_service_and_credential_created = script do
  run Test with
    given = given_with_default_requirement
    when = when_onboard_registrar
    then_ = then_registrar_onboarded

-- * External requirement covered by an extra credential: accepted.
--
-- The outsider acts as an external credential issuer: it self-issues a
-- credential (issuer == holder == outsider) whose claims name the registrar.
-- The SDK accepts issuer-held credentials for any subject the claims name.

given_external_requirement : Script Fixture
given_external_requirement = do
  f <- givenDualGovernance
  providerServiceCid <- setupProviderService f.parties
  let externalRequirement = PartyCredentialRequirement with
        issuer = f.parties.outsider
        requiredClaims = [("kyc", "passed")]
  providerConfigurationCid <- setupProviderConfiguration f providerServiceCid
    [defaultRegistrarRequirement f.parties, externalRequirement] []
  requestCid <- setupRegistrarServiceRequest f
  pure Fixture with ..

mintExternalCredential : Fixture -> Script (ContractId Credential)
mintExternalCredential fx = do
  let parties = fx.f.parties
  submit parties.outsider $ createCmd Credential with
    issuer = parties.outsider
    holder = parties.outsider
    id = "external-kyc"
    description = "External KYC credential for the registrar"
    validFrom = None
    validUntil = None
    claims = [Claim with
      subject = partyToText parties.registrarGov
      property = "kyc"
      value = "passed"]
    observers = Set.fromList [parties.registrarGov, parties.providerGov]

when_onboard_with_extra_credential : Fixture -> Script ()
when_onboard_with_extra_credential fx = do
  externalCredentialCid <- mintExternalCredential fx
  proposalCid <- submit fx.f.providerStack.member1 $ createCmd OnboardRegistrar with
    governanceParty = fx.f.parties.providerGov
    proposer = fx.f.providerStack.member1
    registrar = fx.f.parties.registrarGov
    providerServiceCid = fx.providerServiceCid
    registrarServiceRequestCid = fx.requestCid
    providerConfigurationCid = fx.providerConfigurationCid
    extraRegistrarCredentialCids = [externalCredentialCid]
  let proposalInterfaceCid : ContractId GovernableAction = toInterfaceContractId proposalCid
  _ <- confirmAndExecuteAs fx.f.parties fx.f.providerStack proposalInterfaceCid
  pure ()

then_service_created : Fixture -> () -> Script Failures
then_service_created fx _ = do
  services <- query @RegistrarService fx.f.parties.registrarGov
  pure $ shouldBe "RegistrarService count" 1 (length services)

test_when_external_requirement_covered_then_accepted = script do
  run Test with
    given = given_external_requirement
    when = when_onboard_with_extra_credential
    then_ = then_service_created

-- * External requirement NOT covered: the SDK's requirement check fails
-- inside the accept, rolling back the whole action.

when_onboard_missing_external_credential : Fixture -> Script ()
when_onboard_missing_external_credential fx = do
  proposalCid <- onboardProposal fx fx.f.parties.registrarGov
  confirmThenExecuteMustFail fx.f.parties fx.f.providerStack proposalCid

then_no_service : Fixture -> () -> Script Failures
then_no_service fx _ = do
  services <- query @RegistrarService fx.f.parties.registrarGov
  pure $ shouldBe "RegistrarService count" 0 (length services)

test_when_external_requirement_uncovered_then_execute_fails = script do
  run Test with
    given = given_external_requirement
    when = when_onboard_missing_external_credential
    then_ = then_no_service

-- * Proposal registrar does not match the request: assert fails.

when_onboard_wrong_registrar : Fixture -> Script ()
when_onboard_wrong_registrar fx = do
  proposalCid <- onboardProposal fx fx.f.parties.issuer1
  confirmThenExecuteMustFail fx.f.parties fx.f.providerStack proposalCid

test_when_registrar_mismatch_then_execute_fails = script do
  run Test with
    given = given_with_default_requirement
    when = when_onboard_wrong_registrar
    then_ = then_no_service

-- * Request aimed at a different provider: assert fails. The request's
-- operator is set to providerGov so the governance party can fetch it as an
-- observer, isolating the provider-mismatch assert from visibility failures.

when_onboard_foreign_provider_request : Fixture -> Script ()
when_onboard_foreign_provider_request fx = do
  let parties = fx.f.parties
  foreignRequestCid <- submit parties.registrarGov $ createCmd RegistrarServiceRequest with
    operator = parties.providerGov
    provider = parties.outsider
    registrar = parties.registrarGov
    createTransferRule = None
    createAllocationFactory = None
  proposalCid <- submit fx.f.providerStack.member1 $ createCmd OnboardRegistrar with
    governanceParty = parties.providerGov
    proposer = fx.f.providerStack.member1
    registrar = parties.registrarGov
    providerServiceCid = fx.providerServiceCid
    registrarServiceRequestCid = foreignRequestCid
    providerConfigurationCid = fx.providerConfigurationCid
    extraRegistrarCredentialCids = []
  confirmThenExecuteMustFail fx.f.parties fx.f.providerStack (toInterfaceContractId proposalCid)

test_when_request_provider_mismatch_then_execute_fails = script do
  run Test with
    given = given_with_default_requirement
    when = when_onboard_foreign_provider_request
    then_ = then_no_service

-- * Provider configuration owned by a different provider: assert fails.
-- operator = providerGov makes it fetchable by the governance party.

when_onboard_foreign_configuration : Fixture -> Script ()
when_onboard_foreign_configuration fx = do
  let parties = fx.f.parties
  foreignConfigurationCid <- submit (actAs parties.outsider <> actAs parties.providerGov) $
    createCmd ProviderConfiguration with
      operator = parties.providerGov
      provider = parties.outsider
      registrarRequirements = []
      holderRequirements = []
  proposalCid <- submit fx.f.providerStack.member1 $ createCmd OnboardRegistrar with
    governanceParty = parties.providerGov
    proposer = fx.f.providerStack.member1
    registrar = parties.registrarGov
    providerServiceCid = fx.providerServiceCid
    registrarServiceRequestCid = fx.requestCid
    providerConfigurationCid = foreignConfigurationCid
    extraRegistrarCredentialCids = []
  confirmThenExecuteMustFail fx.f.parties fx.f.providerStack (toInterfaceContractId proposalCid)

test_when_configuration_provider_mismatch_then_execute_fails = script do
  run Test with
    given = given_with_default_requirement
    when = when_onboard_foreign_configuration
    then_ = then_no_service

-- * Non-member confirm is rejected.

when_outsider_confirms : Fixture -> Script ()
when_outsider_confirms fx = do
  proposalCid <- onboardProposal fx fx.f.parties.registrarGov
  outsiderCannotConfirm fx.f.parties fx.f.providerStack proposalCid

then_nothing : Fixture -> () -> Script Failures
then_nothing _ _ = pure []

test_when_outsider_confirms_then_rejected = script do
  run Test with
    given = given_with_default_requirement
    when = when_outsider_confirms
    then_ = then_nothing
