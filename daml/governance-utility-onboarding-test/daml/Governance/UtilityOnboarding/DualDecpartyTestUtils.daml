-- | Fixtures emulating two decentralized parties: a provider decparty and a
-- registrar decparty, each with its own GovernanceRules and members. Tests
-- drive provider-side actions through the provider stack and registrar-side
-- actions through the registrar stack, mirroring the production topology.
module Governance.UtilityOnboarding.DualDecpartyTestUtils where

import DA.Set qualified as Set
import DA.Time (minutes)
import Daml.Script

import Utility.Credential.V0.Credential (PartyCredentialRequirement(..))
import Utility.Registry.App.V0.Configuration.Provider (ProviderConfiguration)
import Utility.Registry.App.V0.Service.AllocationFactory (AllocationFactory)
import Utility.Registry.App.V0.Service.Provider (ProviderService(..))
import Utility.Registry.App.V0.Service.Registrar (RegistrarService, RegistrarServiceRequest)
import Utility.Registry.V0.Configuration.Instrument (InstrumentConfiguration)

import Governance.Action (GovernableAction)
import Governance.ExecutionResult
import Governance.Rules

import Governance.UtilityOnboarding.CreateProviderConfiguration
import Governance.UtilityOnboarding.CreateRegistrarServiceRequest
import Governance.UtilityOnboarding.OnboardRegistrar
import Governance.UtilityOnboarding.ProvisionInstrument

data DualDecpartyParties = DualDecpartyParties
  with
    providerGov : Party
    providerMember1 : Party
    providerMember2 : Party
    providerMember3 : Party
    registrarGov : Party
    registrarMember1 : Party
    registrarMember2 : Party
    registrarMember3 : Party
    operator : Party
    issuer1 : Party
    issuer2 : Party
    outsider : Party
  deriving (Show, Eq)

data GovStack = GovStack
  with
    governanceParty : Party
    member1 : Party
    member2 : Party
    member3 : Party
    rulesCid : ContractId GovernanceRules
  deriving (Show, Eq)

data DualGovFixture = DualGovFixture
  with
    parties : DualDecpartyParties
    providerStack : GovStack
    registrarStack : GovStack
  deriving (Show, Eq)

allocateDualDecpartyParties : Script DualDecpartyParties
allocateDualDecpartyParties = do
  providerGov <- allocateParty "ProviderGov"
  providerMember1 <- allocateParty "ProviderMember1"
  providerMember2 <- allocateParty "ProviderMember2"
  providerMember3 <- allocateParty "ProviderMember3"
  registrarGov <- allocateParty "RegistrarGov"
  registrarMember1 <- allocateParty "RegistrarMember1"
  registrarMember2 <- allocateParty "RegistrarMember2"
  registrarMember3 <- allocateParty "RegistrarMember3"
  operator <- allocateParty "Operator"
  issuer1 <- allocateParty "Issuer1"
  issuer2 <- allocateParty "Issuer2"
  outsider <- allocateParty "Outsider"
  pure DualDecpartyParties with ..

createGovStack : Party -> Party -> Party -> Party -> Script GovStack
createGovStack governanceParty member1 member2 member3 = do
  rulesCid <- submit governanceParty $ createCmd GovernanceRules with
    governanceParty
    members = Set.fromList [member1, member2, member3]
    threshold = 2
    actionConfirmationTimeout = minutes 30
    additionalProposers = None
  pure GovStack with ..

givenDualGovernance : Script DualGovFixture
givenDualGovernance = do
  parties <- allocateDualDecpartyParties
  providerStack <- createGovStack
    parties.providerGov parties.providerMember1 parties.providerMember2 parties.providerMember3
  registrarStack <- createGovStack
    parties.registrarGov parties.registrarMember1 parties.registrarMember2 parties.registrarMember3
  pure DualGovFixture with ..

-- | Confirm with two members of the given stack, then execute as member1.
-- The executor reads as every fixture party so `executeImpl` bodies can
-- fetch contracts visible to any of them.
confirmAndExecuteAs
  : DualDecpartyParties -> GovStack -> ContractId GovernableAction
  -> Script ExecuteConfirmedActionResult
confirmAndExecuteAs parties stack proposalCid = do
  confirmations <- forA [stack.member1, stack.member2] $ \confirmer -> do
    result <- submit (actAs confirmer <> readAs stack.governanceParty) $
      exerciseCmd stack.rulesCid GovernanceRules_ConfirmAction with
        confirmer
        actionProposalCid = proposalCid
    pure result.confirmationCid
  submit (executeContext parties stack) $
    exerciseCmd stack.rulesCid GovernanceRules_ExecuteConfirmedAction with
      executor = stack.member1
      actionProposalCid = proposalCid
      confirmations = confirmations

-- | Same as confirmAndExecuteAs, but the execute submit must fail.
-- Used to test the assert guards inside executeImpl bodies.
confirmThenExecuteMustFail
  : DualDecpartyParties -> GovStack -> ContractId GovernableAction -> Script ()
confirmThenExecuteMustFail parties stack proposalCid = do
  confirmations <- forA [stack.member1, stack.member2] $ \confirmer -> do
    result <- submit (actAs confirmer <> readAs stack.governanceParty) $
      exerciseCmd stack.rulesCid GovernanceRules_ConfirmAction with
        confirmer
        actionProposalCid = proposalCid
    pure result.confirmationCid
  submitMustFail (executeContext parties stack) $
    exerciseCmd stack.rulesCid GovernanceRules_ExecuteConfirmedAction with
      executor = stack.member1
      actionProposalCid = proposalCid
      confirmations = confirmations

executeContext : DualDecpartyParties -> GovStack -> SubmitOptions
executeContext parties stack =
  actAs stack.member1
    <> readAs stack.governanceParty
    <> readAs parties.providerGov
    <> readAs parties.registrarGov
    <> readAs parties.operator
    <> readAs parties.issuer1
    <> readAs parties.issuer2

outsiderCannotConfirm
  : DualDecpartyParties -> GovStack -> ContractId GovernableAction -> Script ()
outsiderCannotConfirm parties stack proposalCid =
  submitMustFail (actAs parties.outsider <> readAs stack.governanceParty) $
    exerciseCmd stack.rulesCid GovernanceRules_ConfirmAction with
      confirmer = parties.outsider
      actionProposalCid = proposalCid

-- | ProviderService requires operator + provider signatures; multi-party
-- submit stands in for the utility-registry provider onboarding chain.
setupProviderService : DualDecpartyParties -> Script (ContractId ProviderService)
setupProviderService parties =
  submit (actAs parties.providerGov <> actAs parties.operator) $
    createCmd ProviderService with
      operator = parties.operator
      provider = parties.providerGov

defaultRegistrarRequirement : DualDecpartyParties -> PartyCredentialRequirement
defaultRegistrarRequirement parties = PartyCredentialRequirement with
  issuer = parties.providerGov
  requiredClaims = [("role", "registrar")]

defaultIssuerRequirement : DualDecpartyParties -> PartyCredentialRequirement
defaultIssuerRequirement parties = PartyCredentialRequirement with
  issuer = parties.registrarGov
  requiredClaims = [("role", "instrument-issuer")]

-- | Run CreateProviderConfiguration through provider governance and return
-- the single resulting configuration cid.
setupProviderConfiguration
  : DualGovFixture -> ContractId ProviderService
  -> [PartyCredentialRequirement] -> [PartyCredentialRequirement]
  -> Script (ContractId ProviderConfiguration)
setupProviderConfiguration f providerServiceCid registrarRequirements holderRequirements = do
  proposalCid <- submit f.providerStack.member1 $ createCmd CreateProviderConfiguration with
    governanceParty = f.parties.providerGov
    proposer = f.providerStack.member1
    providerServiceCid
    registrarRequirements
    holderRequirements
  let proposalInterfaceCid : ContractId GovernableAction = toInterfaceContractId proposalCid
  _ <- confirmAndExecuteAs f.parties f.providerStack proposalInterfaceCid
  [(configurationCid, _)] <- query @ProviderConfiguration f.parties.providerGov
  pure configurationCid

-- | Run CreateRegistrarServiceRequest through registrar governance with both
-- optional artifacts enabled, returning the single resulting request cid.
setupRegistrarServiceRequest : DualGovFixture -> Script (ContractId RegistrarServiceRequest)
setupRegistrarServiceRequest f = do
  proposalCid <- submit f.registrarStack.member1 $ createCmd CreateRegistrarServiceRequest with
    governanceParty = f.parties.registrarGov
    proposer = f.registrarStack.member1
    operator = f.parties.operator
    provider = f.parties.providerGov
    createTransferRule = True
    createAllocationFactory = True
  let proposalInterfaceCid : ContractId GovernableAction = toInterfaceContractId proposalCid
  _ <- confirmAndExecuteAs f.parties f.registrarStack proposalInterfaceCid
  [(requestCid, _)] <- query @RegistrarServiceRequest f.parties.registrarGov
  pure requestCid

data OnboardedRegistrarArtifacts = OnboardedRegistrarArtifacts
  with
    providerServiceCid : ContractId ProviderService
    providerConfigurationCid : ContractId ProviderConfiguration
    registrarServiceCid : ContractId RegistrarService
    allocationFactoryCid : ContractId AllocationFactory
  deriving (Eq, Show)

-- | Walk the flow to an accepted RegistrarService: provider service +
-- configuration, registrar request, then OnboardRegistrar through provider
-- governance. Requirements must be self-issuable by the provider.
setupOnboardedRegistrar
  : DualGovFixture -> [PartyCredentialRequirement] -> Script OnboardedRegistrarArtifacts
setupOnboardedRegistrar f registrarRequirements = do
  providerServiceCid <- setupProviderService f.parties
  providerConfigurationCid <-
    setupProviderConfiguration f providerServiceCid registrarRequirements []
  requestCid <- setupRegistrarServiceRequest f
  proposalCid <- submit f.providerStack.member1 $ createCmd OnboardRegistrar with
    governanceParty = f.parties.providerGov
    proposer = f.providerStack.member1
    providerServiceCid
    registrarServiceRequestCid = requestCid
    providerConfigurationCid
    extraRegistrarCredentialCids = []
  let proposalInterfaceCid : ContractId GovernableAction = toInterfaceContractId proposalCid
  _ <- confirmAndExecuteAs f.parties f.providerStack proposalInterfaceCid
  [(registrarServiceCid, _)] <- query @RegistrarService f.parties.registrarGov
  [(allocationFactoryCid, _)] <- query @AllocationFactory f.parties.registrarGov
  pure OnboardedRegistrarArtifacts with ..

data ProvisionedInstrumentArtifacts = ProvisionedInstrumentArtifacts
  with
    onboarded : OnboardedRegistrarArtifacts
    instrumentConfigurationCid : ContractId InstrumentConfiguration
  deriving (Eq, Show)

-- | Walk the flow to a provisioned instrument named LAUNCH-TOKEN, with the
-- default registrar requirement on the provider side.
setupProvisionedInstrument
  : DualGovFixture -> [PartyCredentialRequirement] -> [Party]
  -> Script ProvisionedInstrumentArtifacts
setupProvisionedInstrument f issuerRequirements initialInstrumentIssuers = do
  onboarded <- setupOnboardedRegistrar f [defaultRegistrarRequirement f.parties]
  proposalCid <- submit f.registrarStack.member1 $ createCmd ProvisionInstrument with
    governanceParty = f.parties.registrarGov
    proposer = f.registrarStack.member1
    registrarServiceCid = onboarded.registrarServiceCid
    instrumentIdText = "LAUNCH-TOKEN"
    additionalIdentifiers = []
    issuerRequirements
    holderRequirements = []
    initialInstrumentIssuers
  let proposalInterfaceCid : ContractId GovernableAction = toInterfaceContractId proposalCid
  _ <- confirmAndExecuteAs f.parties f.registrarStack proposalInterfaceCid
  [(instrumentConfigurationCid, _)] <- query @InstrumentConfiguration f.parties.registrarGov
  pure ProvisionedInstrumentArtifacts with ..
