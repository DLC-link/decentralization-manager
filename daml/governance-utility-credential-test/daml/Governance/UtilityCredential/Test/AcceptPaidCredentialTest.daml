module Governance.UtilityCredential.Test.AcceptPaidCredentialTest where

import DA.List (sort)
import DA.Optional (isSome)
import DA.Text (isInfixOf)
import Daml.Script

import CredentialApp.Splice.Amulet (Amulet, LockedAmulet)
import CredentialApp.Splice.AmuletRules (AppTransferContext)
import Utility.Credential.App.V0.Model.Billing (CredentialBilling)
import Utility.Credential.App.V0.Model.Offer (CredentialOffer)
import Utility.Credential.App.V0.Service.User
  (UserService(..), UserService_OfferPaidCredential(..))
import Utility.Credential.V0.Credential (Credential(..))

import Governance.Action (GovernableAction)
import Governance.Rules

import Governance.UtilityCredential.AcceptPaidCredential
import Governance.UtilityCredential.TestUtils

import TestHarness

-- | The governance party holds a paid credential offer from an external
-- issuer, one unlocked Amulet, and the transfer context of an open round.
data Fixture = Fixture
  with
    parties : CredentialTestParties
    rulesCid : ContractId GovernanceRules
    userServiceCid : ContractId UserService
    offerCid : ContractId CredentialOffer
    depositAmuletCid : ContractId Amulet
    appTransferContext : AppTransferContext
  deriving (Eq, Show)

-- | The holder party plays the external issuer, as in the free accept test.
seedPaidOfferToGovernance : CredentialTestParties -> Script (ContractId CredentialOffer)
seedPaidOfferToGovernance parties = seedPaidOfferWithInitialDeposit parties None

-- | As `seedPaidOfferToGovernance`, with the offer's initial deposit in USD.
seedPaidOfferWithInitialDeposit
  : CredentialTestParties -> Optional Decimal -> Script (ContractId CredentialOffer)
seedPaidOfferWithInitialDeposit parties depositInitialAmountUsd = do
  issuerUserServiceCid <- submit (actAs parties.holder <> actAs parties.operator) $
    createCmd UserService with
      operator = parties.operator
      user = parties.holder
      dso = parties.dso
  result <- submit parties.holder $
    exerciseCmd issuerUserServiceCid UserService_OfferPaidCredential with
      holder = parties.governanceParty
      id = "paid-credential"
      description = "External paid credential offered to governance"
      claims = [testClaim parties.governanceParty]
      billingParams = testBillingParams
      depositInitialAmountUsd
  pure result.credentialOfferCid

givenAmuletOf : Decimal -> Script Fixture
givenAmuletOf = givenOfferAndAmulet None

-- | An offer with the given initial deposit, and one Amulet of the given
-- amount.
givenOfferAndAmulet : Optional Decimal -> Decimal -> Script Fixture
givenOfferAndAmulet depositInitialAmountUsd amuletAmount = do
  parties <- allocateCredentialTestParties
  rulesCid <- createTestGovernance parties
  userServiceCid <- initUserService parties
  offerCid <- seedPaidOfferWithInitialDeposit parties depositInitialAmountUsd
  depositAmuletCid <- createTestAmulet parties parties.governanceParty amuletAmount
  appTransferContext <- createTestAppTransferContext parties
  pure Fixture with ..

-- | 100 Amulet covers the 30 USD deposit, which is 60 Amulet at 0.5 USD.
given_governance_with_paid_offer_and_enough_amulet : Script Fixture
given_governance_with_paid_offer_and_enough_amulet = givenAmuletOf 100.0

-- | 10 Amulet is short of the 60 Amulet deposit.
given_governance_with_paid_offer_and_too_little_amulet : Script Fixture
given_governance_with_paid_offer_and_too_little_amulet = givenAmuletOf 10.0

-- | The offer locks a 20 USD initial deposit instead of its 30 USD target.
given_paid_offer_with_an_initial_deposit : Script Fixture
given_paid_offer_with_an_initial_deposit = givenOfferAndAmulet (Some 20.0) 100.0

-- | Proposes the accept without a stated deposit, the 0.2.0 shape.
proposeAccept : Fixture -> [ContractId Amulet] -> Script (ContractId GovernableAction)
proposeAccept f depositAmulets = proposeAcceptStating f depositAmulets None

proposeAcceptStating
  : Fixture -> [ContractId Amulet] -> Optional Decimal -> Script (ContractId GovernableAction)
proposeAcceptStating f depositAmulets depositAmountUsd = do
  proposalCid <- submit f.parties.member1 $ createCmd AcceptPaidCredential with
    governanceParty = f.parties.governanceParty
    proposer = f.parties.member1
    userServiceCid = f.userServiceCid
    credentialOfferCid = f.offerCid
    depositAmulets
    appTransferContext = f.appTransferContext
    depositAmountUsd
  pure $ toInterfaceContractId proposalCid

-- | The description members see on the vote. They read it as the
-- governance party, the proposal's observer.
voteDescription : Fixture -> ContractId GovernableAction -> Script Text
voteDescription f proposalCid = do
  Some view <- queryInterfaceContractId f.parties.governanceParty proposalCid
  pure view.description

-- | Executes the vote, and fails the script unless the ledger refuses it.
executeMustFail : Fixture -> ContractId GovernableAction -> Script ()
executeMustFail f proposalCid = do
  confirmationCids <- submitConfirmations f.parties.governanceParty f.rulesCid proposalCid
    [f.parties.member1, f.parties.member2]
  submitMustFail (actAs f.parties.member1
    <> readAs f.parties.governanceParty
    <> readAs f.parties.operator
    <> readAs f.parties.dso
    <> readAs f.parties.holder) $
    exerciseCmd f.rulesCid GovernanceRules_ExecuteConfirmedAction with
      executor = f.parties.member1
      actionProposalCid = proposalCid
      confirmations = confirmationCids

-- * Happy path: propose, confirm and execute lock the deposit and create the credential.

-- | Returns the vote's description.
when_accept_paid_executed : Fixture -> Script Text
when_accept_paid_executed f = do
  proposalCid <- proposeAccept f [f.depositAmuletCid]
  description <- voteDescription f proposalCid
  _ <- confirmAndExecute f.parties f.rulesCid proposalCid
    [f.parties.member1, f.parties.member2] f.parties.member1
  pure description

then_credential_and_billing_exist_and_deposit_is_locked : Fixture -> Text -> Script Failures
then_credential_and_billing_exist_and_deposit_is_locked f description = do
  let gov = f.parties.governanceParty
  creds <- query @Credential gov
  billings <- query @CredentialBilling gov
  locked <- query @LockedAmulet gov
  unlocked <- query @Amulet gov
  offers <- query @CredentialOffer gov
  let credentialChecks = case creds of
        [(_, cred)] ->
          shouldBe "credential holder" gov cred.holder <>
          shouldBe "credential issuer" f.parties.holder cred.issuer <>
          shouldBe "credential id" "paid-credential" cred.id
        _ -> shouldBe "Credential count" 1 (length creds)
      billingChecks = case billings of
        [(_, billing)] ->
          shouldBe "billing holder" gov billing.holder <>
          shouldBe "billing credential id" "paid-credential" billing.credentialId
        _ -> shouldBe "CredentialBilling count" 1 (length billings)
      lockedChecks = case locked of
        [(_, l)] ->
          shouldBe "locked owner" gov l.amulet.owner <>
          shouldBe "locked amount" 60.0 l.amulet.amount.initialAmount <>
          shouldBe "lock holders" (sort [f.parties.operator, f.parties.holder]) (sort l.lock.holders)
        _ -> shouldBe "LockedAmulet count" 1 (length locked)
      changeChecks = case unlocked of
        [(cid, change)] ->
          shouldNotBe "deposit Amulet is spent" f.depositAmuletCid cid <>
          shouldBe "change amount" 40.0 change.amount.initialAmount
        _ -> shouldBe "unlocked Amulet count" 1 (length unlocked)
  pure $ credentialChecks <> billingChecks <> lockedChecks <> changeChecks <>
    shouldBe "offer is consumed" 0 (length offers) <>
    shouldBe "a vote without a stated deposit shows no amount" False ("USD" `isInfixOf` description)

-- | The proposal states no deposit, as a 0.2.0 proposal does.
test_when_accept_paid_proposed_and_confirmed_then_deposit_locked_and_credential_exists = script do
  run Test with
    given = given_governance_with_paid_offer_and_enough_amulet
    when = when_accept_paid_executed
    then_ = then_credential_and_billing_exist_and_deposit_is_locked

-- * Deposit Amulets short of the deposit: execution is refused and nothing changes.

when_accept_paid_executed_without_enough_amulet : Fixture -> Script ()
when_accept_paid_executed_without_enough_amulet f = do
  proposalCid <- proposeAccept f [f.depositAmuletCid]
  confirmationCids <- submitConfirmations f.parties.governanceParty f.rulesCid proposalCid
    [f.parties.member1, f.parties.member2]
  submitMustFail (actAs f.parties.member1
    <> readAs f.parties.governanceParty
    <> readAs f.parties.operator
    <> readAs f.parties.dso
    <> readAs f.parties.holder) $
    exerciseCmd f.rulesCid GovernanceRules_ExecuteConfirmedAction with
      executor = f.parties.member1
      actionProposalCid = proposalCid
      confirmations = confirmationCids

then_offer_and_amulet_are_unchanged : Fixture -> () -> Script Failures
then_offer_and_amulet_are_unchanged f _ = do
  let gov = f.parties.governanceParty
  creds <- query @Credential gov
  offer <- queryContractId gov f.offerCid
  amulet <- queryContractId gov f.depositAmuletCid
  pure $
    shouldBe "Credential count" 0 (length creds) <>
    shouldBe "offer is still active" True (isSome offer) <>
    shouldBe "deposit Amulet is still active" True (isSome amulet)

test_when_deposit_amulets_fall_short_then_execution_refused = script do
  run Test with
    given = given_governance_with_paid_offer_and_too_little_amulet
    when = when_accept_paid_executed_without_enough_amulet
    then_ = then_offer_and_amulet_are_unchanged

-- * A proposal without deposit Amulets is refused before any vote.

when_accept_paid_proposed_without_amulets : Fixture -> Script ()
when_accept_paid_proposed_without_amulets f =
  submitMustFail f.parties.member1 $ createCmd AcceptPaidCredential with
    governanceParty = f.parties.governanceParty
    proposer = f.parties.member1
    userServiceCid = f.userServiceCid
    credentialOfferCid = f.offerCid
    depositAmulets = []
    appTransferContext = f.appTransferContext
    depositAmountUsd = None

then_nothing : Fixture -> () -> Script Failures
then_nothing _ _ = pure []

test_when_accept_paid_proposed_without_amulets_then_rejected = script do
  run Test with
    given = given_governance_with_paid_offer_and_enough_amulet
    when = when_accept_paid_proposed_without_amulets
    then_ = then_nothing

-- * A proposer's own UserService is refused at execution, even after the vote.

-- | member1 holds its own UserService, a paid offer and an Amulet, so every
-- upstream check would pass on member1's authority alone.
data ProposerServiceFixture = ProposerServiceFixture
  with
    base : Fixture
    proposerServiceCid : ContractId UserService
    proposerOfferCid : ContractId CredentialOffer
    proposerAmuletCid : ContractId Amulet
  deriving (Eq, Show)

given_proposer_with_its_own_service_offer_and_amulet : Script ProposerServiceFixture
given_proposer_with_its_own_service_offer_and_amulet = do
  base <- givenAmuletOf 100.0
  let parties = base.parties
  proposerServiceCid <- submit (actAs parties.member1 <> actAs parties.operator) $
    createCmd UserService with
      operator = parties.operator
      user = parties.member1
      dso = parties.dso
  issuerUserServiceCid <- submit (actAs parties.holder <> actAs parties.operator) $
    createCmd UserService with
      operator = parties.operator
      user = parties.holder
      dso = parties.dso
  offer <- submit parties.holder $
    exerciseCmd issuerUserServiceCid UserService_OfferPaidCredential with
      holder = parties.member1
      id = "paid-credential-for-proposer"
      description = "Paid credential offered to the proposer"
      claims = [testClaim parties.member1]
      billingParams = testBillingParams
      depositInitialAmountUsd = None
  proposerAmuletCid <- createTestAmulet parties parties.member1 100.0
  pure ProposerServiceFixture with
    base
    proposerServiceCid
    proposerOfferCid = offer.credentialOfferCid
    proposerAmuletCid

when_accept_with_proposer_service_executed : ProposerServiceFixture -> Script ()
when_accept_with_proposer_service_executed f = do
  let parties = f.base.parties
  proposalCid <- submit parties.member1 $ createCmd AcceptPaidCredential with
    governanceParty = parties.governanceParty
    proposer = parties.member1
    userServiceCid = f.proposerServiceCid
    credentialOfferCid = f.proposerOfferCid
    depositAmulets = [f.proposerAmuletCid]
    appTransferContext = f.base.appTransferContext
    depositAmountUsd = None
  let proposalInterfaceCid : ContractId GovernableAction = toInterfaceContractId proposalCid
  confirmationCids <- submitConfirmations parties.governanceParty f.base.rulesCid
    proposalInterfaceCid [parties.member1, parties.member2]
  submitMustFail (actAs parties.member1
    <> readAs parties.governanceParty
    <> readAs parties.operator
    <> readAs parties.dso
    <> readAs parties.holder) $
    exerciseCmd f.base.rulesCid GovernanceRules_ExecuteConfirmedAction with
      executor = parties.member1
      actionProposalCid = proposalInterfaceCid
      confirmations = confirmationCids

then_proposer_gets_no_credential : ProposerServiceFixture -> () -> Script Failures
then_proposer_gets_no_credential f _ = do
  let member1 = f.base.parties.member1
  creds <- query @Credential member1
  offer <- queryContractId member1 f.proposerOfferCid
  amulet <- queryContractId member1 f.proposerAmuletCid
  pure $
    shouldBe "proposer Credential count" 0 (length creds) <>
    shouldBe "proposer offer is still active" True (isSome offer) <>
    shouldBe "proposer Amulet is still active" True (isSome amulet)

test_when_accept_paid_names_the_proposers_service_then_execution_refused = script do
  run Test with
    given = given_proposer_with_its_own_service_offer_and_amulet
    when = when_accept_with_proposer_service_executed
    then_ = then_proposer_gets_no_credential

-- * A stated deposit shows on the vote, and execution locks it.

-- | Returns the vote's description.
when_accept_paid_states_the_deposit_and_executes : Fixture -> Script Text
when_accept_paid_states_the_deposit_and_executes f = do
  proposalCid <- proposeAcceptStating f [f.depositAmuletCid] (Some 30.0)
  description <- voteDescription f proposalCid
  _ <- confirmAndExecute f.parties f.rulesCid proposalCid
    [f.parties.member1, f.parties.member2] f.parties.member1
  pure description

then_the_vote_shows_the_deposit_and_it_is_locked : Fixture -> Text -> Script Failures
then_the_vote_shows_the_deposit_and_it_is_locked f description = do
  locked <- query @LockedAmulet f.parties.governanceParty
  pure $
    shouldContain "vote description" description ", deposit 30.0 USD)" <>
    shouldBe "locked amounts" [60.0] (map ((.amulet.amount.initialAmount) . snd) locked)

test_when_accept_paid_states_the_deposit_then_the_vote_shows_it_and_execution_locks_it = script do
  run Test with
    given = given_governance_with_paid_offer_and_enough_amulet
    when = when_accept_paid_states_the_deposit_and_executes
    then_ = then_the_vote_shows_the_deposit_and_it_is_locked

-- * A stated deposit below the offer's is refused at execution.

when_accept_paid_states_a_smaller_deposit_and_executes : Fixture -> Script ()
when_accept_paid_states_a_smaller_deposit_and_executes f = do
  proposalCid <- proposeAcceptStating f [f.depositAmuletCid] (Some 10.0)
  executeMustFail f proposalCid

test_when_accept_paid_states_a_smaller_deposit_than_the_offer_then_execution_refused = script do
  run Test with
    given = given_governance_with_paid_offer_and_enough_amulet
    when = when_accept_paid_states_a_smaller_deposit_and_executes
    then_ = then_offer_and_amulet_are_unchanged

-- * An offer with an initial deposit locks that, not its target.

when_accept_paid_states_the_target_of_an_offer_with_an_initial_deposit : Fixture -> Script ()
when_accept_paid_states_the_target_of_an_offer_with_an_initial_deposit f = do
  proposalCid <- proposeAcceptStating f [f.depositAmuletCid] (Some 30.0)
  executeMustFail f proposalCid

test_when_the_offer_sets_an_initial_deposit_then_stating_its_target_is_refused = script do
  run Test with
    given = given_paid_offer_with_an_initial_deposit
    when = when_accept_paid_states_the_target_of_an_offer_with_an_initial_deposit
    then_ = then_offer_and_amulet_are_unchanged

when_accept_paid_states_the_initial_deposit_and_executes : Fixture -> Script Text
when_accept_paid_states_the_initial_deposit_and_executes f = do
  proposalCid <- proposeAcceptStating f [f.depositAmuletCid] (Some 20.0)
  description <- voteDescription f proposalCid
  _ <- confirmAndExecute f.parties f.rulesCid proposalCid
    [f.parties.member1, f.parties.member2] f.parties.member1
  pure description

-- | 20 USD at 0.5 USD per Amulet locks 40 Amulet.
then_the_initial_deposit_is_locked : Fixture -> Text -> Script Failures
then_the_initial_deposit_is_locked f description = do
  locked <- query @LockedAmulet f.parties.governanceParty
  pure $
    shouldContain "vote description" description ", deposit 20.0 USD)" <>
    shouldBe "locked amounts" [40.0] (map ((.amulet.amount.initialAmount) . snd) locked)

test_when_the_offer_sets_an_initial_deposit_then_stating_it_executes = script do
  run Test with
    given = given_paid_offer_with_an_initial_deposit
    when = when_accept_paid_states_the_initial_deposit_and_executes
    then_ = then_the_initial_deposit_is_locked
