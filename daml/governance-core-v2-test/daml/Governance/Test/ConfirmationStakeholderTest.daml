-- | Tests for who signs a confirmation and whose authority archives it
-- (#615). Only the governance party signs, so expire and consume need no
-- authority from the confirmer.
module Governance.Test.ConfirmationStakeholderTest where

import DA.Optional (isSome)
import DA.Time (minutes)
import Daml.Script

import Governance.Action (GovernableAction)
import Governance.Confirmation
import Governance.MockActions
import Governance.Rules
import Governance.TestUtils

import TestHarness

-- ============================================================================
-- Fixtures
-- ============================================================================

data StakeholderFixture = StakeholderFixture
  with
    parties : TestParties
    rulesCid : ContractId GovernanceRules
    proposalCid : ContractId GovernableAction
    selfAction : GovernanceSelfAction
    confirmationCid : ContractId GovernanceConfirmation
      -- ^ member1's confirmation of `proposalCid`.
    selfConfirmationCid : ContractId GovernanceSelfConfirmation
      -- ^ member1's confirmation of `selfAction`.
  deriving (Eq, Show)

-- | Both confirmations as the governance party reads them, and whether the
-- confirmer can see them without reading as the governance party.
data Stakeholders = Stakeholders
  with
    confirmation : GovernanceConfirmation
    selfConfirmation : GovernanceSelfConfirmation
    confirmerSeesConfirmation : Bool
    confirmerSeesSelfConfirmation : Bool
  deriving (Eq, Show)

data Remaining = Remaining
  with
    confirmations : Int
    selfConfirmations : Int
    executed : Int
    threshold : Int
  deriving (Eq, Show)

remainingOf : StakeholderFixture -> Script Remaining
remainingOf f = do
  confirmations <- length <$> query @GovernanceConfirmation f.parties.governanceParty
  selfConfirmations <- length <$> query @GovernanceSelfConfirmation f.parties.governanceParty
  executed <- length <$> query @MockActionResult f.parties.governanceParty
  [(_, rules)] <- query @GovernanceRules f.parties.governanceParty
  let threshold = rules.threshold
  pure Remaining with ..

-- ============================================================================
-- Given
-- ============================================================================

-- | Threshold 2 of 3. member1 has confirmed one action of each kind.
given_member1_confirmed_both_kinds : Script StakeholderFixture
given_member1_confirmed_both_kinds = do
  parties <- allocateTestParties
  rulesCid <- createTestGovernance parties
  mockCid <- submit parties.member1 $ createCmd MockProposal with
    governanceParty = parties.governanceParty
    proposer = parties.member1
    label = "TestAction"
    payload = "test"
  let proposalCid = toInterfaceContractId @GovernableAction mockCid
      selfAction = SelfAction_SetThreshold with updatedThreshold = 3
  [confirmationCid] <- submitConfirmations parties.governanceParty rulesCid proposalCid
    [parties.member1]
  [selfConfirmationCid] <- submitSelfConfirmations parties.governanceParty rulesCid selfAction
    [parties.member1]
  pure StakeholderFixture with ..

-- ============================================================================
-- When
-- ============================================================================

when_confirmations_read : StakeholderFixture -> Script Stakeholders
when_confirmations_read f = do
  Some confirmation <- queryContractId f.parties.governanceParty f.confirmationCid
  Some selfConfirmation <- queryContractId f.parties.governanceParty f.selfConfirmationCid
  confirmerSeesConfirmation <- isSome <$> queryContractId f.parties.member1 f.confirmationCid
  confirmerSeesSelfConfirmation <- isSome <$> queryContractId f.parties.member1 f.selfConfirmationCid
  pure Stakeholders with ..

-- | member2 acts alone. The confirmer, member1, takes no part.
when_other_member_expires_both : StakeholderFixture -> Script Remaining
when_other_member_expires_both f = do
  passTime (minutes 31)
  submit (memberContext f.parties.member2 f.parties.governanceParty) $
    exerciseCmd f.rulesCid GovernanceRules_ExpireConfirmation with
      member = f.parties.member2
      staleConfirmationCid = f.confirmationCid
  submit (memberContext f.parties.member2 f.parties.governanceParty) $
    exerciseCmd f.rulesCid GovernanceRules_ExpireGovernanceSelfConfirmation with
      member = f.parties.member2
      staleConfirmationCid = f.selfConfirmationCid
  remainingOf f

-- | member2 adds the second vote to each action. member3, which confirmed
-- neither, executes both and so consumes confirmations it did not make.
when_non_confirmer_executes_both : StakeholderFixture -> Script Remaining
when_non_confirmer_executes_both f = do
  [member2Confirmation] <- submitConfirmations f.parties.governanceParty f.rulesCid f.proposalCid
    [f.parties.member2]
  [member2SelfConfirmation] <- submitSelfConfirmations f.parties.governanceParty f.rulesCid f.selfAction
    [f.parties.member2]
  submit (memberContext f.parties.member3 f.parties.governanceParty) $
    exerciseCmd f.rulesCid GovernanceRules_ExecuteConfirmedAction with
      executor = f.parties.member3
      actionProposalCid = f.proposalCid
      confirmations = [f.confirmationCid, member2Confirmation]
  submit (memberContext f.parties.member3 f.parties.governanceParty) $
    exerciseCmd f.rulesCid GovernanceRules_ExecuteGovernanceAction with
      executor = f.parties.member3
      action = f.selfAction
      confirmations = [f.selfConfirmationCid, member2SelfConfirmation]
  remainingOf f

when_confirmer_cancels_both : StakeholderFixture -> Script Remaining
when_confirmer_cancels_both f = do
  submit (memberContext f.parties.member1 f.parties.governanceParty) $
    exerciseCmd f.confirmationCid GovernanceConfirmation_Cancel
  submit (memberContext f.parties.member1 f.parties.governanceParty) $
    exerciseCmd f.selfConfirmationCid GovernanceSelfConfirmation_Cancel
  remainingOf f

-- | member2 reads as the governance party, so it sees both confirmations,
-- but only their confirmer controls the cancel.
when_other_member_cancels_both : StakeholderFixture -> Script Remaining
when_other_member_cancels_both f = do
  submitMustFail (memberContext f.parties.member2 f.parties.governanceParty) $
    exerciseCmd f.confirmationCid GovernanceConfirmation_Cancel
  submitMustFail (memberContext f.parties.member2 f.parties.governanceParty) $
    exerciseCmd f.selfConfirmationCid GovernanceSelfConfirmation_Cancel
  remainingOf f

-- ============================================================================
-- Then
-- ============================================================================

then_governance_party_is_only_stakeholder : StakeholderFixture -> Stakeholders -> Script Failures
then_governance_party_is_only_stakeholder f s = pure $
  shouldBe "confirmation signatories" [f.parties.governanceParty] (signatory s.confirmation) <>
  shouldBe "confirmation observers" [] (observer s.confirmation) <>
  shouldBe "confirmation confirmer" f.parties.member1 s.confirmation.confirmer <>
  shouldBe "confirmer sees confirmation" False s.confirmerSeesConfirmation <>
  shouldBe "self-confirmation signatories" [f.parties.governanceParty] (signatory s.selfConfirmation) <>
  shouldBe "self-confirmation observers" [] (observer s.selfConfirmation) <>
  shouldBe "self-confirmation confirmer" f.parties.member1 s.selfConfirmation.confirmer <>
  shouldBe "confirmer sees self-confirmation" False s.confirmerSeesSelfConfirmation

then_both_archived_unexecuted : StakeholderFixture -> Remaining -> Script Failures
then_both_archived_unexecuted _ r = pure $
  shouldBe "confirmations left" 0 r.confirmations <>
  shouldBe "self-confirmations left" 0 r.selfConfirmations <>
  shouldBe "actions executed" 0 r.executed <>
  shouldBe "threshold" 2 r.threshold

then_both_executed_and_consumed : StakeholderFixture -> Remaining -> Script Failures
then_both_executed_and_consumed _ r = pure $
  shouldBe "confirmations left" 0 r.confirmations <>
  shouldBe "self-confirmations left" 0 r.selfConfirmations <>
  shouldBe "actions executed" 1 r.executed <>
  shouldBe "threshold" 3 r.threshold

then_both_left_in_place : StakeholderFixture -> Remaining -> Script Failures
then_both_left_in_place _ r = pure $
  shouldBe "confirmations left" 1 r.confirmations <>
  shouldBe "self-confirmations left" 1 r.selfConfirmations

-- ============================================================================
-- Tests
-- ============================================================================

test_when_member_confirms_then_governance_party_is_only_stakeholder = script do
  run Test with
    given = given_member1_confirmed_both_kinds
    when = when_confirmations_read
    then_ = then_governance_party_is_only_stakeholder

test_when_other_member_expires_then_confirmations_archived = script do
  run Test with
    given = given_member1_confirmed_both_kinds
    when = when_other_member_expires_both
    then_ = then_both_archived_unexecuted

test_when_non_confirmer_executes_then_confirmations_consumed = script do
  run Test with
    given = given_member1_confirmed_both_kinds
    when = when_non_confirmer_executes_both
    then_ = then_both_executed_and_consumed

test_when_confirmer_cancels_then_confirmations_archived = script do
  run Test with
    given = given_member1_confirmed_both_kinds
    when = when_confirmer_cancels_both
    then_ = then_both_archived_unexecuted

test_when_other_member_cancels_then_rejected = script do
  run Test with
    given = given_member1_confirmed_both_kinds
    when = when_other_member_cancels_both
    then_ = then_both_left_in_place
