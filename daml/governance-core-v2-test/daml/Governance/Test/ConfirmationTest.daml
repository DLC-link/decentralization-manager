-- | Tests for confirmation lifecycle (create, expire, cancel).
module Governance.Test.ConfirmationTest where

import DA.Time (minutes)
import Daml.Script

import Governance.Action (GovernableAction, GovernableAction_Cancel(..), GovernableAction_ProposerCancel(..))
import Governance.Confirmation
import Governance.MockActions
import Governance.Rules
import Governance.TestUtils

import TestHarness

-- ============================================================================
-- Fixtures
-- ============================================================================

data ConfirmationFixture = ConfirmationFixture
  with
    parties : TestParties
    rulesCid : ContractId GovernanceRules
    proposalCid : ContractId GovernableAction
      -- ^ member1's MockProposal.
  deriving (Eq, Show)

confirmAsMember1 : ConfirmationFixture -> Script (ContractId GovernanceConfirmation)
confirmAsMember1 f = do
  [confirmationCid] <- submitConfirmations f.parties.governanceParty f.rulesCid f.proposalCid
    [f.parties.member1]
  pure confirmationCid

expireAs : ConfirmationFixture -> Party -> ContractId GovernanceConfirmation -> Commands ()
expireAs f member staleConfirmationCid =
  exerciseCmd f.rulesCid GovernanceRules_ExpireConfirmation with
    member
    staleConfirmationCid

confirmationsLeft : ConfirmationFixture -> Script Int
confirmationsLeft f = length <$> query @GovernanceConfirmation f.parties.governanceParty

proposalsLeft : ConfirmationFixture -> Script Int
proposalsLeft f = length <$> query @MockProposal f.parties.governanceParty

-- ============================================================================
-- Given
-- ============================================================================

given_member1_proposal : Script ConfirmationFixture
given_member1_proposal = do
  parties <- allocateTestParties
  rulesCid <- createTestGovernance parties
  proposalCid <- proposeMock parties parties.member1 "TestAction" "test"
  pure ConfirmationFixture with ..

given_member1_proposal_with_3_minute_timeout : Script ConfirmationFixture
given_member1_proposal_with_3_minute_timeout = do
  parties <- allocateTestParties
  rulesCid <- createGovernanceWith parties (minutes 3) None
  proposalCid <- proposeMock parties parties.member1 "TestAction" "test"
  pure ConfirmationFixture with ..

-- | member1's proposal targets a different governance party.
given_member1_proposal_for_other_governance : Script ConfirmationFixture
given_member1_proposal_for_other_governance = do
  parties <- allocateTestParties
  rulesCid <- createTestGovernance parties
  wrongParty <- allocateParty "WrongGovernance"
  mockCid <- submit parties.member1 $ createCmd MockProposal with
    governanceParty = wrongParty
    proposer = parties.member1
    label = "TestAction"
    payload = "test"
  let proposalCid = toInterfaceContractId @GovernableAction mockCid
  pure ConfirmationFixture with ..

-- ============================================================================
-- When
-- ============================================================================

when_member1_confirms : ConfirmationFixture -> Script [(ContractId GovernanceConfirmation, GovernanceConfirmation)]
when_member1_confirms f = do
  _ <- confirmAsMember1 f
  query @GovernanceConfirmation f.parties.governanceParty

when_member1_confirm_rejected : ConfirmationFixture -> Script ()
when_member1_confirm_rejected f =
  submitMustFail (memberContext f.parties.member1 f.parties.governanceParty) $
    exerciseCmd f.rulesCid GovernanceRules_ConfirmAction with
      confirmer = f.parties.member1
      actionProposalCid = f.proposalCid

when_non_member_confirms : ConfirmationFixture -> Script ()
when_non_member_confirms f =
  submitMustFail (memberContext f.parties.outsider f.parties.governanceParty) $
    exerciseCmd f.rulesCid GovernanceRules_ConfirmAction with
      confirmer = f.parties.outsider
      actionProposalCid = f.proposalCid

when_confirmer_cancels : ConfirmationFixture -> Script Int
when_confirmer_cancels f = do
  confirmationCid <- confirmAsMember1 f
  submit (memberContext f.parties.member1 f.parties.governanceParty) $
    exerciseCmd confirmationCid GovernanceConfirmation_Cancel
  confirmationsLeft f

when_member_expires_stale_confirmation : ConfirmationFixture -> Script Int
when_member_expires_stale_confirmation f = do
  confirmationCid <- confirmAsMember1 f
  passTime (minutes 4)
  submit (memberContext f.parties.member2 f.parties.governanceParty) $
    expireAs f f.parties.member2 confirmationCid
  confirmationsLeft f

when_member_expires_valid_confirmation : ConfirmationFixture -> Script ()
when_member_expires_valid_confirmation f = do
  confirmationCid <- confirmAsMember1 f
  submitMustFail (memberContext f.parties.member2 f.parties.governanceParty) $
    expireAs f f.parties.member2 confirmationCid

when_non_member_expires_stale_confirmation : ConfirmationFixture -> Script ()
when_non_member_expires_stale_confirmation f = do
  confirmationCid <- confirmAsMember1 f
  passTime (minutes 31)
  submitMustFail (memberContext f.parties.outsider f.parties.governanceParty) $
    expireAs f f.parties.outsider confirmationCid

when_proposer_cancels_own_proposal : ConfirmationFixture -> Script Int
when_proposer_cancels_own_proposal f = do
  submit f.parties.member1 $
    exerciseCmd f.proposalCid GovernableAction_ProposerCancel
  proposalsLeft f

-- | The choice is gated to the original proposer only.
when_other_member_proposer_cancels : ConfirmationFixture -> Script ()
when_other_member_proposer_cancels f =
  submitMustFail (memberContext f.parties.member2 f.parties.governanceParty) $
    exerciseCmd f.proposalCid GovernableAction_ProposerCancel

-- | The governance-party cancel path remains available alongside the
-- proposer-cancel path.
when_governance_party_cancels_proposal : ConfirmationFixture -> Script Int
when_governance_party_cancels_proposal f = do
  submit f.parties.governanceParty $
    exerciseCmd f.proposalCid GovernableAction_Cancel
  proposalsLeft f

-- ============================================================================
-- Then
-- ============================================================================

then_member1_confirmation_recorded
  : ConfirmationFixture -> [(ContractId GovernanceConfirmation, GovernanceConfirmation)] -> Script Failures
then_member1_confirmation_recorded f confirmations = pure $
  shouldBe "confirmers" [f.parties.member1] (map ((.confirmer) . snd) confirmations) <>
  shouldBe "action labels" ["TestAction"] (map ((.actionLabel) . snd) confirmations)

then_no_confirmations_left : ConfirmationFixture -> Int -> Script Failures
then_no_confirmations_left _ count = pure $
  shouldBe "confirmations left" 0 count

then_no_proposals_left : ConfirmationFixture -> Int -> Script Failures
then_no_proposals_left _ count = pure $
  shouldBe "proposals left" 0 count

then_nothing : ConfirmationFixture -> () -> Script Failures
then_nothing _ _ = pure []

-- ============================================================================
-- Tests
-- ============================================================================

test_when_member_confirms_then_confirmation_recorded = script do
  run Test with
    given = given_member1_proposal
    when = when_member1_confirms
    then_ = then_member1_confirmation_recorded

test_when_non_member_confirms_then_rejected = script do
  run Test with
    given = given_member1_proposal
    when = when_non_member_confirms
    then_ = then_nothing

test_when_confirmer_cancels_then_confirmation_archived = script do
  run Test with
    given = given_member1_proposal
    when = when_confirmer_cancels
    then_ = then_no_confirmations_left

test_when_member_expires_stale_confirmation_then_archived = script do
  run Test with
    given = given_member1_proposal_with_3_minute_timeout
    when = when_member_expires_stale_confirmation
    then_ = then_no_confirmations_left

test_when_member_expires_valid_confirmation_then_rejected = script do
  run Test with
    given = given_member1_proposal
    when = when_member_expires_valid_confirmation
    then_ = then_nothing

test_when_non_member_expires_confirmation_then_rejected = script do
  run Test with
    given = given_member1_proposal
    when = when_non_member_expires_stale_confirmation
    then_ = then_nothing

test_when_proposal_targets_other_governance_then_confirm_rejected = script do
  run Test with
    given = given_member1_proposal_for_other_governance
    when = when_member1_confirm_rejected
    then_ = then_nothing

test_when_proposer_cancels_own_proposal_then_archived = script do
  run Test with
    given = given_member1_proposal
    when = when_proposer_cancels_own_proposal
    then_ = then_no_proposals_left

test_when_other_member_proposer_cancels_then_rejected = script do
  run Test with
    given = given_member1_proposal
    when = when_other_member_proposer_cancels
    then_ = then_nothing

test_when_governance_party_cancels_proposal_then_archived = script do
  run Test with
    given = given_member1_proposal
    when = when_governance_party_cancels_proposal
    then_ = then_no_proposals_left
