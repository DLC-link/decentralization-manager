# decman-cli profiles. Copy to `config.toml` and edit. Do not commit it.
#
# Each [[profiles]] is one login to one decman node.
# - The terminal UI shows these profiles in its login menu. When a config.toml
#   with at least one profile exists, the terminal UI ignores .env.
# - Commands pick a profile with `-p <name>` (or DECMAN_PROFILE).
#
# Set `password` or `password_command`, not both. `password_command` runs a
# shell command and reads the password from its first line of output.

[[profiles]]
name = "Localnet"
network = "localnet"
api_url = "http://localhost:8081"
username = "alice"
password = "change-me"

[[profiles]]
name = "Devnet"
network = "devnet"
api_url = "https://decman.devnet.example"
username = "bob"
password_command = "pass show decman/devnet"
# Every request that is not a read (GET) needs --yes on this profile.
require_yes = true

# Optional OAuth overrides (auto-discovered from /auth-config if omitted):
# oauth_token_url = "https://keycloak.example/realms/r/protocol/openid-connect/token"
# oauth_client_id = "decman-cli"
# oauth_client_secret = ""
# oauth_audience = ""
# oauth_scope = ""

# Optional node settings (see README "Node settings"). Each section belongs to
# the [[profiles]] entry above it.
# [profiles.admin_client]
# client_id = "participant-admin"
# client_secret_command = "pass show decman/devnet/admin"
#
# [profiles.party_credentials]
# member_party_id = "member-1::1220..."
# user_id = "member-user"
# keycloak_url = "https://keycloak.example"
# keycloak_realm = "nodes"
# keycloak_client_id = "member-1"
# client_secret_command = "pass show decman/devnet/member"
